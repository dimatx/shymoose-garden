---
import Layout from "../layouts/Layout.astro";
import PlantCard from "../components/PlantCard.astro";
import Icon from "../components/Icon.astro";
import { getSortedPlants } from "../lib/plants";
import { feedingProducts, feedingTreatments } from "../data/feeding";
import { FEEDING_SEASONS, TREATMENT_TRIGGERS, feedingSearchText, getTreatmentCatalog, treatmentsForPlant } from "../lib/feeding";
import { SOIL_REACTIONS, SOIL_FERTILITIES, plantCareGroup } from "../lib/plant-care";

const plants = (await getSortedPlants()).filter((plant) => !plant.data.archived);
const catalog = getTreatmentCatalog(plants, feedingTreatments);
---

<Layout title="Feeding & soil care" description="Seasonal treatments and shared soil categories, linked to the garden catalog.">
  <h1 class="mb-5 font-serif text-3xl font-semibold tracking-tight sm:text-4xl">Feeding & soil care</h1>
  <div data-feeding-catalog>
    <div data-feeding-tools hidden>
      <div role="group" aria-label="Browse feeding" class="mb-4 flex flex-wrap gap-2">
        <button data-feeding-view="season" type="button" aria-pressed="true" class="filter-chip">By season</button>
        <button data-feeding-view="category" type="button" aria-pressed="false" class="filter-chip">By category</button>
        <button data-feeding-view="product" type="button" aria-pressed="false" class="filter-chip">By fertilizer</button>
      </div>
      <div class="mb-4 flex flex-wrap items-end gap-3">
        <label data-season-control class="control-label">
          Season
          <select data-feeding-season class="filter-input">
            {Object.entries(FEEDING_SEASONS).map(([id, label]) => <option value={id}>{label}</option>)}
          </select>
        </label>
        <label data-product-control hidden class="control-label">
          Fertilizer
          <select data-feeding-product class="filter-input">
            <option value="">Choose a fertilizer</option>
            {feedingProducts.map((product) => <option value={product.id}>{product.name}</option>)}
          </select>
        </label>
        <label data-category-control hidden class="control-label">
          Soil pH
          <select data-feeding-acidity class="filter-input">
            <option value="">All pH classes</option>
            {Object.entries(SOIL_REACTIONS).filter(([id]) => id !== "unreviewed").map(([id, label]) => <option value={id}>{label}</option>)}
          </select>
        </label>
        <label data-category-control hidden class="control-label">
          Soil fertility
          <select data-feeding-fertility class="filter-input">
            <option value="">All fertility classes</option>
            {Object.entries(SOIL_FERTILITIES).filter(([id]) => id !== "unreviewed").map(([id, label]) => <option value={id}>{label}</option>)}
          </select>
        </label>
        <label class="control-label flex-1">
          Search plants
          <input data-feeding-search type="search" autocomplete="off" placeholder="Common or Latin name" class="filter-input" />
        </label>
        <button data-feeding-clear type="button" class="min-h-11 rounded-lg px-2 text-sm font-semibold text-leaf-700 hover:underline dark:text-leaf-300">Clear filters</button>
      </div>
    </div>

    <p data-feeding-safety class="mb-4 flex items-start gap-2 text-sm text-leaf-700 dark:text-leaf-300">
      <Icon name="alert-triangle" class="mt-0.5 h-4 w-4 shrink-0" />
      <span>Do not feed drought-stressed plants or frozen soil.</span>
    </p>
    <p data-feeding-status role="status" class="mb-3 text-sm font-semibold"></p>
    <p data-feeding-empty hidden class="rounded-2xl border border-leaf-300 p-4 text-sm dark:border-leaf-700"></p>
    <button data-treatment-back hidden type="button" class="mb-3 inline-flex min-h-11 items-center gap-1.5 rounded-lg text-sm font-semibold text-leaf-700 dark:text-leaf-300">
      <Icon name="chevron-left" class="h-4 w-4" /> All treatments
    </button>
    <button data-related-toggle hidden type="button" aria-expanded="false" aria-controls="feeding-treatments" class="mb-3 inline-flex min-h-11 items-center gap-2 rounded-lg text-sm font-semibold text-leaf-700 dark:text-leaf-300">
      <span data-related-label>Related treatments</span> <Icon name="chevron-down" class="h-4 w-4" />
    </button>
    <p data-no-seasonal-applications hidden class="mb-3 text-sm text-leaf-700 dark:text-leaf-300">No seasonal applications.</p>

    <div id="feeding-treatments" data-treatment-list class="space-y-2">
      {catalog.map(({ treatment, plants: members }, index) => {
        const product = feedingProducts.find((item) => item.id === treatment.productId);
        return (
          <>
          {index === catalog.findIndex((item) => item.treatment.action === "withhold") && (
            <h2 data-withhold-heading class="pb-1 pt-4 font-serif text-xl font-semibold">Leave unfed</h2>
          )}
          <details
            id={treatment.id}
            name="feeding-treatment"
            data-treatment
            data-action={treatment.action}
            data-seasons={treatment.seasons.join("|")}
            data-product={treatment.productId ?? ""}
            data-total={members.length}
            class="treatment group rounded-2xl border border-leaf-200 bg-white dark:border-leaf-800 dark:bg-leaf-900"
          >
            <summary class="flex min-h-22 cursor-pointer list-none items-center gap-3 p-4 [&::-webkit-details-marker]:hidden">
              <span class="min-w-0 flex-1">
                <span class="block font-semibold">{treatment.title}</span>
                <span data-treatment-summary-meta class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-leaf-600 dark:text-leaf-300">
                  <span>{treatment.action === "withhold" ? "Year-round" : treatment.seasons.map((id) => FEEDING_SEASONS[id]).join(" · ")}</span>
                  <span>{product?.name ?? treatment.material}</span>
                  <span data-treatment-count>{members.length} plants</span>
                </span>
                <span data-treatment-summary-meta class="mt-1 block text-xs text-leaf-700 dark:text-leaf-300">{TREATMENT_TRIGGERS[treatment.trigger]}</span>
              </span>
              <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-leaf-600 transition-transform group-open:rotate-180 dark:text-leaf-300" />
            </summary>
            <div class="border-t border-leaf-200 px-4 pb-4 pt-3 dark:border-leaf-800">
              <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
                <div><dt class="text-xs font-semibold uppercase text-leaf-600 dark:text-leaf-300">When</dt><dd class="mt-1">{treatment.when}</dd></div>
                <div class="order-3 col-span-2 sm:order-none sm:col-span-1"><dt class="text-xs font-semibold uppercase text-leaf-600 dark:text-leaf-300">Trigger</dt><dd class="mt-1">{TREATMENT_TRIGGERS[treatment.trigger]}</dd></div>
                <div class="order-2 sm:order-none"><dt class="text-xs font-semibold uppercase text-leaf-600 dark:text-leaf-300">Use</dt><dd class="mt-1">{product?.name ?? treatment.material}</dd></div>
              </dl>
              {treatment.caution && <p data-treatment-caution class="mt-3 text-sm font-semibold">{treatment.caution}</p>}
              {(treatment.steps.length > 0 || Boolean(treatment.exceptions?.length)) && (
              <details class="mt-2">
                <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg text-sm font-semibold text-leaf-700 dark:text-leaf-300">Application instructions <Icon name="chevron-down" class="h-4 w-4" /></summary>
                <ol class="mt-2 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-leaf-700 dark:text-leaf-300">
                  {treatment.steps.map((step) => <li>{step}</li>)}
                </ol>
                {treatment.exceptions?.map((exception) => (
                  <p data-treatment-exception={exception.plantIds.join("|")} class="mt-3 text-sm text-leaf-700 dark:text-leaf-300">
                    <strong>{exception.label}: </strong>{exception.note}
                  </p>
                ))}
              </details>
              )}
              <noscript>
                <details class="mt-2">
                  <summary class="inline-flex min-h-11 cursor-pointer items-center text-sm font-semibold">Plants in this treatment ({members.length})</summary>
                  <ul>{members.map((plant) => <li><a class="source-link" href={`/plants/${plant.id}/`}>{plant.data.name}</a></li>)}</ul>
                </details>
              </noscript>
            </div>
          </details>
          </>
        );
      })}
    </div>

    <section data-treatment-plants class="mt-5">
      <h2 data-plants-heading class="mb-3 font-serif text-2xl font-semibold">Plants</h2>
      <ul data-feeding-grid class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {plants.map((plant) => {
          const care = plantCareGroup(plant.id);
          const treatments = treatmentsForPlant(plant, feedingTreatments);
          return (
            <li
              data-feeding-plant={plant.id}
              data-search={feedingSearchText(plant)}
              data-acidity={care.acidity === "unreviewed" ? undefined : care.acidity}
              data-fertility={care.fertility === "unreviewed" ? undefined : care.fertility}
              data-treatments={treatments.map((treatment) => treatment.id).join("|")}
            >
              <PlantCard plant={plant} />
            </li>
          );
        })}
      </ul>
    </section>
    <noscript><p class="mt-4 text-sm">All active plants are shown. Open a treatment for its instructions and plant list; filtering requires JavaScript.</p></noscript>

  </div>
</Layout>

<style>
  .treatment { scroll-margin-top: 7rem; }
  .treatment[open] { border-color: var(--color-leaf-500); }
  .treatment[open] > summary { min-height: 44px; padding-block: 12px; }
  .treatment[open] > summary [data-treatment-summary-meta] { display: none; }
  .filter-chip { min-height: 44px; border-radius: 9999px; border: 1px solid var(--color-leaf-300); padding: 8px 14px; font-size: 14px; font-weight: 500; color: var(--color-leaf-800); }
  .filter-chip[aria-pressed="true"] { background: var(--color-leaf-600); border-color: var(--color-leaf-600); color: white; }
  :global(.dark) .filter-chip { border-color: var(--color-leaf-700); color: var(--color-leaf-200); }
  :global(.dark) .filter-chip[aria-pressed="true"] { color: white; }
  .control-label { display: flex; min-width: 0; flex-direction: column; gap: 4px; font-size: 14px; font-weight: 600; }
  .filter-input { min-height: 44px; min-width: 0; width: 100%; border: 1px solid var(--color-leaf-300); border-radius: 9999px; background: white; padding: 8px 14px; font-size: 16px; font-weight: 400; }
  .filter-input::placeholder { color: var(--color-leaf-600); }
  :global(.dark) .filter-input { background: var(--color-leaf-900); border-color: var(--color-leaf-700); }
  :global(.dark) .filter-input::placeholder { color: var(--color-leaf-300); }
  .source-link { display: inline-flex; min-height: 44px; align-items: center; border-radius: 6px; color: var(--color-leaf-700); text-decoration: underline; text-underline-offset: 4px; }
  :global(.dark) .source-link { color: var(--color-leaf-300); }
  button:focus-visible, select:focus-visible, input:focus-visible, summary:focus-visible, a:focus-visible { outline: 2px solid var(--color-leaf-500); outline-offset: 3px; }
  @media (max-width: 639px) {
    .control-label { flex-basis: 100%; }
    .control-label:has([data-feeding-acidity]), .control-label:has([data-feeding-fertility]) { flex: 1 1 calc(50% - 6px); }
  }
</style>

<script>
  import "../scripts/feeding-guide";
</script>
