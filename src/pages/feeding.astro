---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { getSortedPlants, plantUrl } from "../lib/plants";
import { feedingRecommendations } from "../data/feeding";
import {
  FEEDING_EVIDENCE, feedingSearchText, getFeedingGuide,
  getFeedingProductGroups, recommendationsForPlant,
} from "../lib/feeding";

const plants = (await getSortedPlants()).filter((plant) => !plant.data.archived);
const guide = getFeedingGuide(plants, feedingRecommendations);
const products = getFeedingProductGroups(guide.entries);
---

<Layout title="Feeding guide" description="Choose a season or fertilizer, find the matching garden plants, and open only the care guidance you need.">
  <header class="mb-5">
    <h1 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">Feeding guide</h1>
    <p class="mt-1 text-leaf-700 dark:text-leaf-300">Choose a season, a fertilizer, or a plant.</p>
  </header>

  <div data-feeding-guide>
    <div data-feeding-tools hidden>
      <div role="group" aria-label="Browse feeding guidance" class="feeding-modes mb-4 grid grid-cols-3 gap-1 rounded-2xl bg-leaf-100 p-1 dark:bg-leaf-900">
        <button type="button" data-feeding-view="season" aria-pressed="true" class="mode-button">By season</button>
        <button type="button" data-feeding-view="product" aria-pressed="false" class="mode-button">By fertilizer</button>
        <button type="button" data-feeding-view="plants" aria-pressed="false" class="mode-button">Find a plant</button>
      </div>
      <div class="mb-3 flex flex-wrap items-end gap-3">
        <label data-season-control class="flex min-w-0 flex-1 basis-full flex-col gap-1 text-sm font-semibold sm:basis-0">
          Seasonal window
          <select data-feeding-window class="feeding-input">
            <option value="spring">Late winter & spring</option>
            <option value="growing">Planting & growing season</option>
            <option value="no-routine">Usually no feeding needed</option>
          </select>
        </label>
        <label data-product-control hidden class="flex min-w-0 flex-1 basis-full flex-col gap-1 text-sm font-semibold sm:basis-0">
          Fertilizer
          <select data-feeding-product class="feeding-input">
            <option value="">Choose a fertilizer</option>
            {products.map(({ product, plants: members }) => <option value={product.id}>{product.name} · {members.length} plants</option>)}
            <option value="no-product">No preferred product recorded</option>
          </select>
        </label>
        <div class="flex min-w-0 flex-1 basis-full flex-col gap-1 sm:basis-0">
          <label for="feeding-search" data-search-label class="text-sm font-semibold">Search these plants</label>
          <div class="flex gap-2">
            <input id="feeding-search" data-feeding-search type="search" autocomplete="off" placeholder="Common or Latin name" class="feeding-input min-w-0 flex-1" />
            <button data-feeding-reset type="button" class="min-h-11 rounded-xl px-2 text-sm font-semibold text-leaf-700 hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-900">Reset</button>
          </div>
        </div>
      </div>
      <p data-product-context hidden class="mb-3 text-sm text-leaf-700 dark:text-leaf-300"></p>
    </div>

    <aside aria-label="Before feeding" class="mb-4 flex items-start gap-2 rounded-xl border border-leaf-300 px-3 py-2.5 text-sm dark:border-leaf-700">
      <Icon name="alert-triangle" class="mt-0.5 h-4 w-4 shrink-0 text-leaf-700 dark:text-leaf-300" />
      <p>Check soil and pH first. <strong>Never feed drought-stressed plants or frozen soil.</strong></p>
    </aside>

    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
      <p data-feeding-count role="status" class="text-sm font-semibold">{plants.length} active plants</p>
      <a href="#about-feeding" class="inline-flex min-h-11 items-center rounded-lg text-sm text-leaf-700 underline underline-offset-4 dark:text-leaf-300">About the guidance</a>
    </div>
    <p data-feeding-empty hidden class="rounded-2xl border border-leaf-300 p-5 text-leaf-700 dark:border-leaf-700 dark:text-leaf-300"></p>
    <noscript><p class="mb-4 text-sm">All active plants are shown below. Open a plant for its guidance; filtering requires JavaScript.</p></noscript>

    <ul data-feeding-results class="space-y-2">
      {plants.map((plant) => {
        const entry = recommendationsForPlant(plant.id, feedingRecommendations)[0];
        return (
          <li data-feeding-item>
            <details
              id={`plant-${plant.id}`}
              name="feeding-plant"
              data-feeding-row
              data-plant-id={plant.id}
              data-plant-name={plant.data.name}
              data-search={feedingSearchText(plant)}
              data-recommendation={entry?.id}
              data-window={entry?.window}
              data-product={entry?.product?.id ?? "no-product"}
              data-evidence={entry?.evidenceScope}
              class="feeding-row group overflow-hidden rounded-2xl border border-leaf-200 bg-white dark:border-leaf-800 dark:bg-leaf-900"
            >
              <summary class="flex min-h-22 cursor-pointer list-none items-center gap-3 p-3 [&::-webkit-details-marker]:hidden">
                <Image src={plant.data.photo} alt="" width={96} height={96} format="webp" class="h-14 w-14 shrink-0 rounded-xl object-cover" />
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold leading-snug">{plant.data.name}</span>
                  <span class="mt-1 block text-xs text-leaf-600 dark:text-leaf-300">
                    {entry
                      ? `${entry.need}${entry.product ? ` · ${entry.product.name}` : ""}${entry.evidenceScope === "general" ? " · General baseline" : ""}`
                      : "Guidance not yet reviewed"}
                  </span>
                  {entry && <span class="mt-1 block text-xs font-medium text-leaf-800 dark:text-leaf-200">{entry.quickCaution}</span>}
                </span>
                <Icon name="chevron-down" class="h-4 w-4 shrink-0 text-leaf-600 transition-transform group-open:rotate-180 dark:text-leaf-300" />
              </summary>
              <div class="border-t border-leaf-200 px-4 pb-4 pt-3 dark:border-leaf-800">
                <p class="text-sm italic text-leaf-600 dark:text-leaf-300">{plant.data.latinName}</p>
                {entry ? (
                  <>
                    <p class="mt-3 font-semibold">{entry.condition}</p>
                    <p class="mt-2 text-sm font-semibold">Caution: {entry.warning}</p>
                    <dl class="mt-4 space-y-4 text-sm leading-relaxed">
                      <div><dt class="font-semibold">When</dt><dd class="mt-1 text-leaf-700 dark:text-leaf-300">{entry.timing}</dd></div>
                      <div><dt class="font-semibold">Fertilizer type</dt><dd class="mt-1 text-leaf-700 dark:text-leaf-300">{entry.requirement}</dd></div>
                      <div><dt class="font-semibold">Product choice</dt><dd class="mt-1 text-leaf-700 dark:text-leaf-300">{entry.product ? `${entry.product.name}. ${entry.product.note}` : "None recorded. If feeding is needed, choose by soil results."}</dd></div>
                      <div><dt class="font-semibold">How to apply</dt><dd class="mt-1 text-leaf-700 dark:text-leaf-300">{entry.instructions}</dd></div>
                      <div><dt class="font-semibold">Soil & acidity</dt><dd class="mt-1 text-leaf-700 dark:text-leaf-300">{entry.soil}</dd></div>
                    </dl>
                    <details class="mt-4">
                      <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg text-sm font-semibold text-leaf-700 dark:text-leaf-300">Sources & review <Icon name="info" class="h-4 w-4" /></summary>
                      <div class="mt-2 text-sm">
                        <p class="font-semibold">{FEEDING_EVIDENCE[entry.evidenceScope]}</p>
                        <p class="mt-1 text-leaf-700 dark:text-leaf-300">{entry.evidenceScope === "general" ? "This is a shared established-landscape or border baseline, not a cultivar-specific feeding assessment." : "Plant or plant-group advice; not a soil test or a diagnosis of this individual plant."}</p>
                        <ul class="mt-2">
                          {entry.product && <li><a href={entry.product.url} class="source-link">Current {entry.product.name} directions</a></li>}
                          {entry.sources.map((source) => <li><a href={source.url} class="source-link">{source.label}</a></li>)}
                        </ul>
                        <p class="mt-2 text-leaf-600 dark:text-leaf-300">Reviewed <time datetime={entry.reviewedOn}>{entry.reviewedOn}</time>. Weather and product labels can change.</p>
                      </div>
                    </details>
                  </>
                ) : (
                  <p class="mt-3 text-sm text-leaf-700 dark:text-leaf-300">No feeding schedule or product has been reviewed for this plant yet. That does not mean no fertilizer is needed. Use its care notes and soil-test-based advice before feeding.</p>
                )}
                <a href={plantUrl(plant)} class="source-link mt-2 font-semibold">Full plant page <Icon name="arrow-up-right" class="ml-1 h-4 w-4" /></a>
              </div>
            </details>
          </li>
        );
      })}
    </ul>
  </div>

  <details id="about-feeding" class="feeding-row mt-6 border-t border-leaf-200 pt-3 dark:border-leaf-800">
    <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-lg text-sm font-semibold">How this guide works <Icon name="info" class="h-4 w-4" /></summary>
    <div class="mt-2 space-y-3 text-sm leading-relaxed text-leaf-700 dark:text-leaf-300">
      <p>This is a seasonal reference for in-ground plants, not an application tracker. A fertilizer choice is separate from a demonstrated need to feed. Follow the current label, keep fertilizers away from pets, and avoid runoff into waterways.</p>
      <p>{guide.plantGroupCount} active plants have plant/group guidance; {guide.baselineCount} have only a general baseline; {guide.missing.length} await review. Archived plants are excluded. Sources support advice, not a diagnosis of the garden’s soil.</p>
      <p>Product lists contain reviewed choices, not every plant a manufacturer lists as compatible. No preferred product recorded does not mean no suitable product exists.</p>
      {guide.missing.length > 0 && (
        <details>
          <summary class="inline-flex min-h-11 cursor-pointer items-center rounded-lg font-semibold">Plants awaiting review ({guide.missing.length})</summary>
          <ul class="mt-2">
            {guide.missing.map((plant) => <li><a data-feeding-missing={plant.id} href={`/feeding/?plant=${plant.id}#plant-${plant.id}`} class="source-link">{plant.data.name}</a></li>)}
          </ul>
        </details>
      )}
    </div>
  </details>
</Layout>

<style>
  .feeding-row { scroll-margin-top: 7rem; }
  .feeding-row[open] { border-color: var(--color-leaf-500); }
  .mode-button { min-height: 44px; border-radius: 12px; padding: 8px 6px; font-size: 14px; font-weight: 600; color: var(--color-leaf-700); }
  .mode-button[aria-pressed="true"] { background: var(--color-leaf-700); color: white; }
  :global(.dark) .mode-button { color: var(--color-leaf-300); }
  :global(.dark) .mode-button[aria-pressed="true"] { background: var(--color-leaf-300); color: var(--color-leaf-950); }
  .feeding-input { min-height: 44px; width: 100%; border: 1px solid var(--color-leaf-300); border-radius: 12px; background: white; padding: 8px 12px; font-size: 16px; font-weight: 400; }
  :global(.dark) .feeding-input { border-color: var(--color-leaf-700); background: var(--color-leaf-900); }
  .feeding-input::placeholder { color: var(--color-leaf-600); }
  :global(.dark) .feeding-input::placeholder { color: var(--color-leaf-300); }
  .source-link { display: inline-flex; min-height: 44px; align-items: center; border-radius: 6px; color: var(--color-leaf-700); text-decoration: underline; text-underline-offset: 4px; }
  :global(.dark) .source-link { color: var(--color-leaf-300); }
  input:focus-visible, select:focus-visible, button:focus-visible, summary:focus-visible, a:focus-visible { outline: 2px solid var(--color-leaf-500); outline-offset: 3px; }
</style>

<script>
  import "../scripts/feeding-guide";
</script>
