---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggle.astro";
import QRScanner from "../components/QRScanner.astro";
import Icon from "../components/Icon.astro";
import { buildVersion } from "../lib/build-info";

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative URL of a social-share image. */
  image?: string;
  /** Alt text describing the share image. */
  imageAlt?: string;
}

const {
  title,
  description = "A living catalog of the plants in the ShyMoose garden. Scan, learn, grow.",
  image,
  imageAlt,
} = Astro.props;

const siteName = "ShyMoose Garden";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;

---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="apple-touch-icon" href="/icon-180x180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ShyMoose" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#27592c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d2010" media="(prefers-color-scheme: dark)" />

    <!-- Buttery client-side morphs between pages (e.g. card → detail photo). -->
    <ClientRouter />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!-- Set theme before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (() => {
        let stored;
        try {
          stored = localStorage.getItem("theme");
        } catch (error) {
          console.warn("Theme preference storage is unavailable.", error);
        }
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body
    class="app-bg min-h-full bg-leaf-50 font-sans text-leaf-950 antialiased transition-colors dark:bg-leaf-950 dark:text-leaf-50"
  >
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:p-3 focus:text-leaf-950">
      Skip to content
    </a>
    <header
      class="sticky top-0 z-40 border-b border-leaf-200/70 bg-leaf-50/80 backdrop-blur-md dark:border-leaf-800/70 dark:bg-leaf-950/80"
    >
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a
          href="/"
          class="group flex items-center gap-2 font-serif text-lg font-semibold tracking-tight"
        >
          <span
            class="grid h-9 w-9 place-items-center rounded-full bg-leaf-600 text-leaf-50 shadow-sm transition-transform group-hover:scale-105 dark:bg-leaf-500"
            aria-hidden="true"
          >
            <Icon name="sprout" class="h-5 w-5" />
          </span>
          <span>ShyMoose Garden</span>
        </a>
        <div class="flex items-center gap-1.5">
          <!-- Desktop: inline links with full text. -->
          <a
            href="/bloom/"
            class="hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800 sm:inline-flex"
          >
            <Icon name="bloom" class="h-4 w-4" />
            <span>Bloom calendar</span>
          </a>
          <a
            href="/pruning/"
            class="hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800 sm:inline-flex"
          >
            <Icon name="scissors" class="h-4 w-4" />
            <span>Pruning calendar</span>
          </a>
          <a
            href="/map/"
            data-beta-feature
            hidden
            class="items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800 sm:inline-flex"
          >
            <Icon name="map" class="h-4 w-4" />
            <span>Garden map</span>
          </a>

          <!-- Mobile: a menu button revealing the same links with full text. -->
          <div class="relative sm:hidden">
            <button
              id="nav-menu-button"
              type="button"
              aria-expanded="false"
              aria-controls="nav-menu"
              aria-label="Open menu"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800"
            >
              <Icon name="menu" class="h-5 w-5" />
            </button>
            <div
              id="nav-menu"
              hidden
              class="absolute right-0 top-full z-50 mt-2 min-w-52 overflow-hidden rounded-2xl border border-leaf-200/80 bg-white p-1.5 shadow-lg dark:border-leaf-800/80 dark:bg-leaf-900"
            >
              <a
                href="/bloom/"
                class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-100 dark:text-leaf-200 dark:hover:bg-leaf-800"
              >
                <Icon name="bloom" class="h-4 w-4 shrink-0" />
                <span>Bloom calendar</span>
              </a>
              <a
                href="/pruning/"
                class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-100 dark:text-leaf-200 dark:hover:bg-leaf-800"
              >
                <Icon name="scissors" class="h-4 w-4 shrink-0" />
                <span>Pruning calendar</span>
              </a>
              <a
                href="/map/"
                data-beta-feature
                hidden
                class="items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-100 dark:text-leaf-200 dark:hover:bg-leaf-800"
              >
                <Icon name="map" class="h-4 w-4 shrink-0" />
                <span>Garden map</span>
              </a>
            </div>
          </div>

          <!-- Scanning a QR with the camera only makes sense on a phone, so
               this button is hidden on larger (sm+) screens. -->
          <button
            id="qr-scan-button"
            type="button"
            aria-label="Scan plant QR code"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800 sm:hidden"
          >
            <Icon name="qr-scan" class="h-5 w-5" />
          </button>

          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-3xl px-4 pb-20 pt-6 sm:px-6">
      <slot />
    </main>

    <footer
      class="mx-auto max-w-3xl px-4 pb-10 text-center text-sm text-leaf-600 dark:text-leaf-400 sm:px-6"
    >
      <p>🌿 Grown with care in the ShyMoose garden.</p>
      <p class="mt-2 text-xs text-leaf-500 dark:text-leaf-500">
        {buildVersion}
      </p>
    </footer>

    <script>
      // Mobile navigation menu: toggle open/closed, and close on outside
      // click, Escape, or when navigating. Re-bound after each view
      // transition (astro:page-load) using a dataset guard so we never
      // attach duplicate listeners.
      let navEvents: AbortController | undefined;
      document.addEventListener("astro:before-swap", () => navEvents?.abort());
      function initNavMenu() {
        const button = document.getElementById("nav-menu-button");
        const menu = document.getElementById("nav-menu");
        if (!button || !menu) return;

        const open = () => {
          menu.hidden = false;
          button.setAttribute("aria-expanded", "true");
          button.setAttribute("aria-label", "Close menu");
        };
        const close = () => {
          menu.hidden = true;
          button.setAttribute("aria-expanded", "false");
          button.setAttribute("aria-label", "Open menu");
        };
        const toggle = () => (menu.hidden ? open() : close());

        if (button.dataset.bound !== "true") {
          button.dataset.bound = "true";
          navEvents?.abort();
          navEvents = new AbortController();
          const { signal } = navEvents;

          button.addEventListener("click", (e) => {
            e.stopPropagation();
            toggle();
          }, { signal });

          // Close when clicking anywhere outside the menu.
          document.addEventListener("click", (e) => {
            if (
              !menu.hidden &&
              !menu.contains(e.target as Node) &&
              e.target !== button
            ) {
              close();
            }
          }, { signal });

          // Close on Escape and return focus to the button.
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !menu.hidden) {
              close();
              button.focus();
            }
          }, { signal });
        }

        // Always start closed on (re)bind / navigation.
        close();
      }

      initNavMenu();
      document.addEventListener("astro:page-load", initNavMenu);

      // Garden map is still in progress — its nav links only appear when
      // ?beta is present in the URL. See src/pages/map.astro for the
      // matching gate on the page itself.
      function revealBetaFeatures() {
        if (!new URLSearchParams(location.search).has("beta")) return;
        document
          .querySelectorAll<HTMLAnchorElement>("[data-beta-feature]")
          .forEach((el) => {
            el.removeAttribute("hidden");
            const url = new URL(el.href);
            url.searchParams.set("beta", "");
            el.href = url.href;
          });
      }

      revealBetaFeatures();
      document.addEventListener("astro:page-load", revealBetaFeatures);
    </script>

    <script>
      import {
        isTransitionBeforePreparationEvent,
        isTransitionBeforeSwapEvent,
      } from "astro:transitions/client";
      // Scoped shared-element morph between the plant list and a detail page.
      //
      // Cards do NOT carry a permanent `view-transition-name`: if all 44 did,
      // navigating back to the list would wrap every card photo in its own
      // view-transition group and fade them in together — a full-grid flash.
      // Instead we give exactly ONE image the name `plant-photo-<id>` for the
      // duration of a single navigation: the source card on the way into a
      // detail page, and the matching card on the way back. The detail hero
      // keeps its static name, so the two endpoints share a name and morph,
      // while every other card swaps instantly with no animation.
      {
        const DETAIL = /^\/plants\/([^/]+)\/?$/;
        const clearNames = (doc: Document | DocumentFragment) =>
          doc
            .querySelectorAll<HTMLElement>("[data-plant-photo]")
            .forEach((el) => (el.style.viewTransitionName = ""));
        const tag = (el: HTMLElement | null, id: string) => {
          if (el) el.style.viewTransitionName = `plant-photo-${id}`;
        };

        // Forward (list → detail): the source card lives in the OLD document,
        // whose snapshot is taken before the swap, so tag it as early as
        // possible — during preparation, while the list is still on screen.
        document.addEventListener("astro:before-preparation", (e) => {
          if (!isTransitionBeforePreparationEvent(e)) return;
          clearNames(document);
          const detail = e.to?.pathname?.match(DETAIL);
          if (e.from?.pathname === "/" && detail) {
            tag(
              document.querySelector<HTMLElement>(
                `[data-plant-photo="${detail[1]}"]`,
              ),
              detail[1],
            );
          }
        });

        // Back (detail → list): the target card lives in the INCOMING
        // document, whose snapshot is taken after the swap, so tag it there.
        document.addEventListener("astro:before-swap", (e) => {
          if (!isTransitionBeforeSwapEvent(e)) return;
          clearNames(e.newDocument);
          const detail = e.from?.pathname?.match(DETAIL);
          if (detail && e.to?.pathname === "/") {
            tag(
              e.newDocument.querySelector(`[data-plant-photo="${detail[1]}"]`),
              detail[1],
            );
          }
        });
      }
    </script>
    <QRScanner />
  </body>
</html>
