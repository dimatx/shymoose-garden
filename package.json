{
  "name": "shymoose-garden",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A plant catalog for the ShyMoose garden — scan a QR code by a plant to learn about it.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "import:plants": "node --env-file=.env scripts/import-plants.mjs",
    "gen:shortlinks": "node --env-file=.env scripts/gen-shortlinks.mjs",
    "gen:signs": "node scripts/gen-signs.mjs",
    "gen:3mf": "node scripts/gen-3mf.mjs",
    "publish": "npm run build && npm run gen:shortlinks && npm run gen:signs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.13",
    "astro": "^5.14.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6"
  }
}
