---
import type { CareApplication } from "../lib/feeding";
import Icon from "./Icon.astro";
interface Props { application: CareApplication }
const { application } = Astro.props;
---

<div data-care-application={application.treatmentId} class="space-y-1">
  <p data-care-use class="font-medium">{application.use}</p>
  <p data-care-when>{application.when}</p>
  {application.condition && <p data-care-condition class="text-leaf-600 dark:text-leaf-300">{application.condition}</p>}
  {application.caution && <p data-care-caution class="font-medium">{application.caution}</p>}
  {(application.steps.length > 0 || application.notes.length > 0) && (
    <details class="group pt-1">
      <summary class="inline-flex min-h-11 cursor-pointer items-center gap-1.5 rounded-lg font-semibold text-leaf-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:text-leaf-300"><span>How to apply</span><span class="sr-only"> — {application.when}</span><Icon name="chevron-down" class="h-3.5 w-3.5 transition-transform group-open:rotate-180" /></summary>
      <ol data-care-steps class="list-decimal space-y-2 pb-2 pl-5">
        {application.steps.map((step) => <li>{step}</li>)}
      </ol>
      {application.notes.map((note) => <p data-care-note class="pb-2">{note}</p>)}
    </details>
  )}
</div>
