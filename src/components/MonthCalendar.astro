---
/**
 * A shared month-by-month calendar used by both the Bloom Calendar and the
 * Pruning Calendar. Give it a list of rows (each with the months it's "active")
 * and it renders:
 *   1. a month chart whose columns start at the current month, and
 *   2. a "now" panel underneath listing what's active this month.
 *
 * Two things make this readable on a phone:
 *   - Rows are ordered by *what's happening next*, not by January — active now
 *     at the top, then upcoming, with what just finished at the bottom.
 *   - Only as many month columns as actually fit are shown, and the arrows
 *     page forward through the year. The plant-name column never scrolls away,
 *     so you keep the context of which row you're reading.
 *
 * Both the order and the visible window are recomputed in the browser, so the
 * page stays correct between rebuilds (a build in May still reads right in
 * June).
 */
import Icon from "./Icon.astro";
import type { CalendarRow } from "../lib/plants";
import {
  monthAt,
  monthDistance,
  orderRows,
  WINDOW_WIDE,
} from "../lib/calendar-order";

interface Props {
  rows: CalendarRow[];
  /** Verb shown in the "now" panel heading, e.g. "Blooming" or "Prune". */
  nowVerb: string;
  /** Message shown when nothing is active in the current month. */
  emptyMessage: string;
  /** Warm tint for the "now" badge, distinguishing the two calendars. */
  accent?: "leaf" | "bloom" | "soil";
}

const { rows, nowVerb, emptyMessage, accent = "leaf" } = Astro.props;

const accentBadge = {
  leaf: "bg-leaf-100 text-leaf-600 dark:bg-leaf-800 dark:text-leaf-300",
  bloom: "bg-bloom-100 text-bloom-600 dark:bg-bloom-600/25 dark:text-bloom-300",
  soil: "bg-soil-100 text-soil-600 dark:bg-soil-600/25 dark:text-soil-300",
}[accent];

// Bar colour matches the per-plant view's pills (see PlantMonths.astro) so the
// big calendar and the single-plant one read as the same thing.
const accentBar = {
  leaf: "bg-leaf-400 dark:bg-leaf-500",
  bloom: "bg-bloom-300 dark:bg-bloom-500",
  soil: "bg-soil-300 dark:bg-soil-500",
}[accent];

const MONTHS = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];

// Build-time current month, used as the pre-hydration fallback for both the
// row order and the "now" list.
const buildMonth = new Date().getMonth() + 1; // 1–12

// Sort here so the two callers can't drift; the script re-sorts if the
// visitor's month has moved on since the build.
const sorted = orderRows(rows, buildMonth);

// Single source of truth for chip styling — read back by the script so the
// client-rendered chips match the server-rendered ones exactly.
const chipClass =
  "inline-flex items-center gap-1.5 rounded-full bg-leaf-100 px-3 py-1.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-200 dark:bg-leaf-800 dark:text-leaf-100 dark:hover:bg-leaf-700";

const navButtonClass =
  "grid h-9 w-9 shrink-0 place-items-center rounded-full border border-leaf-200/80 bg-white text-leaf-700 transition hover:bg-leaf-100 dark:border-leaf-800/80 dark:bg-leaf-900 dark:text-leaf-300 dark:hover:bg-leaf-800";
---

<!-- Calendar chart -->
<section class="month-calendar" data-build-month={buildMonth}>
  <!-- Month paging, revealed by the script once it can drive the buttons. -->
  <div class="cal-nav mb-3 hidden items-center justify-between gap-2" data-cal-nav>
    <div class="flex shrink-0 items-center gap-1">
      <!-- Mirrors the reset button opposite so the range label stays centred. -->
      <div class="h-9 w-9" aria-hidden="true"></div>
      <button type="button" class={navButtonClass} data-cal-step="-1">
        <span class="sr-only">Show earlier months</span>
        <Icon name="chevron-left" class="h-4 w-4" strokeWidth={2} />
      </button>
    </div>
    <span
      class="min-w-0 flex-1 truncate text-center text-sm font-semibold text-leaf-800 dark:text-leaf-200"
      data-cal-range
      aria-live="polite"></span>
    <div class="flex shrink-0 items-center gap-1">
      <button type="button" class={navButtonClass} data-cal-step="1">
        <span class="sr-only">Show later months</span>
        <Icon name="chevron-right" class="h-4 w-4" strokeWidth={2} />
      </button>
      <!-- Jumps back to the current month; hidden (but still reserving its slot)
           whenever the window is already anchored there. -->
      <button
        type="button"
        class={`${navButtonClass} invisible`}
        title="Back to this month"
        data-cal-today
      >
        <span class="sr-only">Back to this month</span>
        <Icon name="locate" class="h-4 w-4" strokeWidth={2} />
      </button>
    </div>
  </div>

  <div class="overflow-x-auto pb-2">
    <div class="cal-chart relative" data-cal-chart>
      <!-- Month header -->
      <div class="cal-grid">
        <div data-cal-label-probe></div>
        {
          MONTHS.map((m, i) => {
            const offset = monthDistance(buildMonth, i + 1);
            return (
            <div
              data-month={i + 1}
              style={`order:${offset + 1}`}
              class:list={[
                "month-head cal-col rounded-t-md px-1 py-1.5 text-center text-xs font-semibold uppercase tracking-wide text-leaf-500 dark:text-leaf-400",
                offset >= WINDOW_WIDE && "is-out",
              ]}
            >
              {m}
            </div>
            );
          })
        }
      </div>

      <!-- Rows -->
      <div
        class="relative divide-y divide-leaf-200/70 dark:divide-leaf-800/70"
        data-cal-rows
      >
        <!-- "Today" indicator line, positioned by the script below. -->
        <div
          class="now-line pointer-events-none absolute bottom-0 top-0 z-10 hidden w-px"
          data-cal-now-line
          aria-hidden="true"
        >
          <span class="now-line-dot"></span>
        </div>
        {
          sorted.map((row) => (
            <div
              class="calendar-row cal-grid items-center py-1.5"
              data-months={row.months.join(",")}
              data-name={row.name}
              data-url={row.url}
            >
              <a
                href={row.url}
                class="cal-name pr-2 text-sm font-medium leading-tight text-leaf-800 transition hover:text-leaf-950 dark:text-leaf-200 dark:hover:text-leaf-50"
                title={row.name}
              >
                {row.name}
              </a>
              {MONTHS.map((_, i) => {
                const month = i + 1;
                const offset = monthDistance(buildMonth, month);
                const active = row.months.includes(month);
                // Neighbours wrap around the year end, so a run like Nov–Feb
                // reads as one continuous bar rather than two stubs.
                const isStart = active && !row.months.includes(monthAt(month, -1));
                const isEnd = active && !row.months.includes(monthAt(month, 1));
                const rounding = [
                  isStart ? "rounded-l-full" : "",
                  isEnd ? "rounded-r-full" : "",
                ].join(" ");
                return (
                  <div
                    data-month={month}
                    style={`order:${offset + 1}`}
                    class:list={["month-cell cal-col px-px py-0.5", offset >= WINDOW_WIDE && "is-out"]}
                  >
                    <div class={`h-5 ${active ? `${accentBar} ${rounding}` : ""}`} />
                  </div>
                );
              })}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Active now -->
<section
  class="mt-6 rounded-2xl border border-leaf-200/80 bg-white p-5 dark:border-leaf-800/80 dark:bg-leaf-900"
>
  <h2 class="flex items-center gap-2 font-serif text-lg font-semibold">
    <span
      class={`grid h-7 w-7 place-items-center rounded-full ${accentBadge}`}
      aria-hidden="true"
    >
      <slot name="now-icon" />
    </span>
    {nowVerb} <span id="now-month" class="text-leaf-600 dark:text-leaf-400">now</span>
  </h2>
  <ul
    id="now-list"
    class="mt-3 flex flex-wrap gap-2"
    data-build-month={buildMonth}
    data-chip-class={chipClass}
  >
    {
      sorted
        .filter((r) => r.months.includes(buildMonth))
        .map((r) => (
          <li>
            <a href={r.url} class={chipClass}>
              <span class="h-2 w-2 rounded-full bg-leaf-500" aria-hidden="true" />
              {r.name}
            </a>
          </li>
        ))
    }
  </ul>
  <p id="now-empty" class="mt-3 hidden text-sm text-leaf-600 dark:text-leaf-400">
    {emptyMessage}
  </p>
</section>

<style>
  /* One shared grid for the header and every row, so the columns line up. The
     script sets --visible to the window size that fits the screen. */
  .cal-chart {
    /* The same generous name column at every width: the script only ever shows
       a short window of months, so there's room to spare for the names. */
    --label-w: 11rem;
    /* Matches WINDOW_WIDE, so the server-rendered chart already shows the right
       window and desktop loads don't flash a denser grid before hydration. */
    --visible: 6;
    /* Keeps the columns legible on a narrow screen without JS, letting the
       wrapper scroll instead of squeezing them to nothing. */
    min-width: calc(var(--label-w) + var(--visible) * 2.25rem);
  }
  .cal-grid {
    display: grid;
    grid-template-columns: var(--label-w) repeat(var(--visible), minmax(0, 1fr));
    gap: 1px;
  }
  /* Months outside the visible window are pulled out of the grid entirely. */
  .cal-col.is-out {
    display: none;
  }
  /* Long plant names wrap rather than being cut off. Paging through a short
     month window leaves room for a third line before anything is clipped. */
  .cal-name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  /* The current-month column is highlighted by the script below. */
  .month-head.is-current {
    color: var(--color-leaf-700);
    background-color: color-mix(in oklab, var(--color-leaf-200) 70%, transparent);
  }
  :global(.dark) .month-head.is-current {
    color: var(--color-leaf-100);
    background-color: color-mix(in oklab, var(--color-leaf-700) 50%, transparent);
  }
  .month-cell.is-current {
    background-color: color-mix(in oklab, var(--color-leaf-200) 55%, transparent);
  }
  :global(.dark) .month-cell.is-current {
    background-color: color-mix(in oklab, var(--color-leaf-800) 60%, transparent);
  }

  /* A slim vertical line marking the exact spot we're at today. Positioned via
     --now-pos (0–1 across the *visible* month columns), set by the script. */
  .now-line {
    left: calc(var(--label-w) + (100% - var(--label-w)) * var(--now-pos, 0));
    background-color: var(--color-leaf-600);
    /* A soft halo in the page background colour lifts the line off the column
       dividers, so it stays readable even when it lands on a grid line. */
    box-shadow: 0 0 0 1.5px var(--color-leaf-50);
  }
  :global(.dark) .now-line {
    background-color: var(--color-leaf-300);
    box-shadow: 0 0 0 1.5px var(--color-leaf-950);
  }
  .now-line-dot {
    position: absolute;
    left: 50%;
    top: 0;
    height: 0.5rem;
    width: 0.5rem;
    transform: translate(-50%, -50%);
    border-radius: 9999px;
    background-color: var(--color-leaf-600);
    box-shadow: 0 0 0 2px var(--color-leaf-50);
  }
  :global(.dark) .now-line-dot {
    background-color: var(--color-leaf-300);
    box-shadow: 0 0 0 2px var(--color-leaf-950);
  }
</style>

<script>
  import {
    monthAt,
    monthDistance,
    orderRows,
    WINDOW_NARROW,
    WINDOW_WIDE,
  } from "../lib/calendar-order";

  const MONTH_NAMES = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
  ];
  const MONTH_SHORT = MONTH_NAMES.map((m) => m.slice(0, 3));

  /** Narrowest a month column may get before we start hiding months. */
  const MIN_COLUMN_PX = 42;

  function initCalendar() {
    const calendar = document.querySelector<HTMLElement>(".month-calendar");
    if (!calendar) return;

    const chart = calendar.querySelector<HTMLElement>("[data-cal-chart]");
    const rowsParent = calendar.querySelector<HTMLElement>("[data-cal-rows]");
    const nav = calendar.querySelector<HTMLElement>("[data-cal-nav]");
    const rangeLabel = calendar.querySelector<HTMLElement>("[data-cal-range]");
    const todayButton = calendar.querySelector<HTMLElement>("[data-cal-today]");
    const nowLine = calendar.querySelector<HTMLElement>("[data-cal-now-line]");
    const labelProbe = calendar.querySelector<HTMLElement>("[data-cal-label-probe]");
    const scroller = chart?.parentElement;
    if (!chart || !rowsParent || !scroller) return;

    const now = new Date().getMonth() + 1; // 1–12
    const buildMonth = Number(calendar.dataset.buildMonth) || now;

    // Label: "in June"
    const label = document.getElementById("now-month");
    if (label) label.textContent = `in ${MONTH_NAMES[now - 1]}`;

    const rows = Array.from(rowsParent.querySelectorAll<HTMLElement>(".calendar-row"));
    const monthsOf = (row: HTMLElement) =>
      (row.dataset.months || "").split(",").map(Number).filter(Boolean);

    // Re-sort for the visitor's real month if the build has gone stale.
    if (now !== buildMonth) {
      const ordered = orderRows(
        rows.map((el) => ({ el, name: el.dataset.name || "", months: monthsOf(el) })),
        now,
      );
      rowsParent.append(...ordered.map((row) => row.el));
    }

    // Highlight the current month (header cell + every row's cell).
    calendar.querySelectorAll<HTMLElement>("[data-month]").forEach((el) => {
      el.classList.toggle("is-current", Number(el.dataset.month) === now);
    });

    // --- Visible month window --------------------------------------------
    // The window starts at whichever month the reader paged to, so by default
    // the leftmost column is "now" and the plant names never scroll away.
    let start = now;
    let visible = WINDOW_WIDE;

    function fittingMonths(): number {
      const available = scroller!.clientWidth;
      const labelWidth = labelProbe?.getBoundingClientRect().width ?? 0;
      if (!available || !labelWidth) return WINDOW_WIDE;
      const count = Math.floor((available - labelWidth) / MIN_COLUMN_PX);
      // Two fixed sizes rather than "however many fit": a window that sizes
      // itself to the viewport lands on awkward counts and leaves the columns
      // too thin to read at a glance.
      if (count >= WINDOW_WIDE) return WINDOW_WIDE;
      return Math.max(1, Math.min(WINDOW_NARROW, count));
    }

    function render() {
      chart!.style.setProperty("--visible", String(visible));

      calendar!.querySelectorAll<HTMLElement>("[data-month]").forEach((el) => {
        const offset = monthDistance(start, Number(el.dataset.month));
        el.style.order = String(offset + 1);
        el.classList.toggle("is-out", offset >= visible);
      });

      // The window is always shorter than a year now, so there's always more
      // to page to. Revealed from the script so the buttons never appear
      // without the code that makes them work.
      nav?.classList.remove("hidden");
      nav?.classList.add("flex");

      if (rangeLabel) {
        const last = monthAt(start, visible - 1);
        rangeLabel.textContent =
          visible === 1
            ? MONTH_NAMES[start - 1]
            : `${MONTH_SHORT[start - 1]} – ${MONTH_SHORT[last - 1]}`;
      }
      if (todayButton) {
        // Keep the slot occupied so the centred range label never shifts.
        const atNow = start === now;
        todayButton.classList.toggle("invisible", atNow);
        todayButton.toggleAttribute("inert", atNow);
      }

      // Place the "today" line within the visible window, drifting across the
      // current month's column as the days pass. Hidden once you page past it.
      if (nowLine) {
        const offset = monthDistance(start, now);
        if (offset >= visible) {
          nowLine.classList.add("hidden");
        } else {
          const today = new Date();
          const daysInMonth = new Date(
            today.getFullYear(),
            today.getMonth() + 1,
            0,
          ).getDate();
          const monthFraction = (today.getDate() - 0.5) / daysInMonth;
          nowLine.style.setProperty(
            "--now-pos",
            String((offset + monthFraction) / visible),
          );
          nowLine.classList.remove("hidden");
        }
      }
    }

    function fit() {
      const fits = fittingMonths();
      if (fits === visible) return;
      visible = fits;
      render();
    }

    calendar.querySelectorAll<HTMLElement>("[data-cal-step]").forEach((button) => {
      button.addEventListener("click", () => {
        start = monthAt(start, Number(button.dataset.calStep));
        render();
      });
    });
    todayButton?.addEventListener("click", () => {
      start = now;
      render();
    });

    visible = fittingMonths();
    render();
    new ResizeObserver(fit).observe(scroller);

    // --- "Now" list -------------------------------------------------------
    const list = document.getElementById("now-list");
    const empty = document.getElementById("now-empty");
    const chipClass = list?.dataset.chipClass ?? "";

    // Build a chip safely via the DOM (no innerHTML / no string interpolation),
    // so plant names can never be misread as markup.
    function makeChip(name: string, url: string): HTMLLIElement {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = url;
      a.className = chipClass;
      const dot = document.createElement("span");
      dot.className = "h-2 w-2 rounded-full bg-leaf-500";
      dot.setAttribute("aria-hidden", "true");
      a.append(dot, document.createTextNode(name));
      li.append(a);
      return li;
    }

    // Recompute the "now" list for the visitor's actual current month, in the
    // same order the rows now appear in.
    if (list && now !== buildMonth) {
      const active = Array.from(
        rowsParent.querySelectorAll<HTMLElement>(".calendar-row"),
      )
        .filter((row) => monthsOf(row).includes(now))
        .map((row) => makeChip(row.dataset.name || "", row.dataset.url || "#"));
      list.replaceChildren(...active);
      if (empty) empty.classList.toggle("hidden", active.length > 0);
    } else if (list && empty) {
      empty.classList.toggle("hidden", list.children.length > 0);
    }
  }

  initCalendar();
  document.addEventListener("astro:page-load", initCalendar);
</script>
