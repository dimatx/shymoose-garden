---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  plant: CollectionEntry<"plants">;
  /**
   * Set on the first (LCP) card so its image gets high fetch priority and
   * loads eagerly. Only one card should be `priority`.
   */
  priority?: boolean;
  /**
   * Set on the remaining above-the-fold cards: they load eagerly (no lazy
   * deferral) but at normal priority, so they fill the initial viewport
   * without competing with the LCP image. Off-screen cards leave this unset
   * and stay lazy.
   */
  eager?: boolean;
}

const { plant, priority = false, eager = false } = Astro.props;
const { name, latinName, photo, photoAlt, shortDescription } = plant.data;
---

<a
  href={`/plants/${plant.id}/`}
  data-astro-prefetch="viewport"
  class="group flex flex-col overflow-hidden rounded-2xl border border-leaf-200/80 bg-white shadow-sm transition duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:border-transparent dark:bg-leaf-900 dark:shadow-none dark:ring-1 dark:ring-white/10 dark:hover:ring-white/20"
>
  <div class="relative aspect-4/3 overflow-hidden bg-leaf-100 dark:bg-leaf-800">
    <Image
      src={photo}
      alt={photoAlt || name}
      width={640}
      height={480}
      widths={[320, 480, 640]}
      sizes="(min-width: 640px) 320px, 100vw"
      quality={72}
      loading={priority || eager ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      data-plant-photo={plant.id}
      class="h-full w-full rounded-t-2xl object-cover transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
    />
    <!-- Soft scrim keeps the rounded image edge from clashing with busy photos. -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-black/10 to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h2 class="font-serif text-lg font-semibold leading-tight">{name}</h2>
    <p class="text-sm italic text-leaf-600 dark:text-leaf-400">{latinName}</p>
    <p class="mt-1 line-clamp-2 text-sm text-leaf-700 dark:text-leaf-300">
      {shortDescription}
    </p>
  </div>
</a>
