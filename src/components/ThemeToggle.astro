---
// A small, accessible light/dark toggle. State is persisted in localStorage
// and applied before paint by the inline script in Layout.astro.
import Icon from "./Icon.astro";
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle relative inline-grid h-9 w-9 place-items-center overflow-hidden rounded-full border border-leaf-200 bg-leaf-100/60 text-leaf-700 transition hover:bg-leaf-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:border-leaf-800 dark:bg-leaf-900/60 dark:text-leaf-200 dark:hover:bg-leaf-800"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <!-- Both icons are stacked and crossfade/rotate between each other. -->
  <Icon name="sun" class="theme-icon theme-icon--sun col-start-1 row-start-1 h-5 w-5" />
  <Icon name="moon" class="theme-icon theme-icon--moon col-start-1 row-start-1 h-5 w-5" />
</button>

<style>
  /* The icons are rendered by the <Icon> component, so they live outside this
     file's scoped styles — target them with :global() (still anchored under
     .theme-toggle, which is in this template and carries the scope). */
  .theme-toggle :global(.theme-icon) {
    transition:
      opacity 0.3s ease,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* Light mode: show the moon (tap to go dark); hide the sun. */
  .theme-toggle :global(.theme-icon--sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  .theme-toggle :global(.theme-icon--moon) {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  /* Dark mode: flip them. */
  :global(.dark) .theme-toggle :global(.theme-icon--sun) {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  :global(.dark) .theme-toggle :global(.theme-icon--moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle :global(.theme-icon) {
      transition: none;
    }
  }
</style>

<script>
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
  let preference: string | null = null;
  try {
    preference = localStorage.getItem("theme");
  } catch (error) {
    console.warn("Theme preference storage is unavailable.", error);
  }

  function applyTheme() {
    const dark = preference === "dark" || (preference !== "light" && systemTheme.matches);
    document.documentElement.classList.toggle("dark", dark);
    const toggle = document.getElementById("theme-toggle");
    toggle?.setAttribute("aria-pressed", String(dark));
    toggle?.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
  }

  // Re-bind on every navigation so the toggle keeps working with the
  // client-side router (View Transitions).
  function initThemeToggle() {
    applyTheme();
    const toggle = document.getElementById("theme-toggle");
    if (!toggle || toggle.dataset.bound) return;
    toggle.dataset.bound = "true";
    toggle.addEventListener("click", () => {
      preference = document.documentElement.classList.contains("dark") ? "light" : "dark";
      applyTheme();
      try {
        localStorage.setItem("theme", preference);
      } catch (error) {
        console.warn("Theme preference could not be saved; it will last for this visit only.", error);
      }
    });
  }

  initThemeToggle();
  document.addEventListener("astro:page-load", initThemeToggle);

  // The <html> class can be reset during a view transition; reapply the saved
  // theme right after the DOM swaps to avoid a flash of the wrong mode.
  document.addEventListener("astro:after-swap", applyTheme);
  systemTheme.addEventListener("change", applyTheme);
  window.addEventListener("storage", (event) => {
    if (event.key !== "theme" && event.key !== null) return;
    preference = event.newValue;
    applyTheme();
  });
</script>
