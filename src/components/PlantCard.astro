---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  plant: CollectionEntry<"plants">;
  /**
   * Set on the first (above-the-fold) card so its image is the LCP element:
   * loaded eagerly with high priority instead of lazily. Leave false/unset
   * for every other card so they stay lazy.
   */
  priority?: boolean;
}

const { plant, priority = false } = Astro.props;
const { name, latinName, photo, photoAlt, shortDescription } = plant.data;
---

<a
  href={`/plants/${plant.id}/`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-leaf-200/80 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:border-leaf-800/80 dark:bg-leaf-900"
>
  <div class="aspect-4/3 overflow-hidden bg-leaf-100 dark:bg-leaf-800">
    <Image
      src={photo}
      alt={photoAlt || name}
      width={640}
      height={480}
      widths={[320, 480, 640]}
      sizes="(min-width: 640px) 320px, 100vw"
      quality={72}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h2 class="font-serif text-lg font-semibold leading-tight">{name}</h2>
    <p class="text-sm italic text-leaf-600 dark:text-leaf-400">{latinName}</p>
    <p class="mt-1 line-clamp-2 text-sm text-leaf-700 dark:text-leaf-300">
      {shortDescription}
    </p>
  </div>
</a>
