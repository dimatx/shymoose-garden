{
  "name": "shymoose-garden",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A plant catalog for the ShyMoose garden — scan a QR code by a plant to learn about it.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "import:plants": "node scripts/import-plants.mjs",
    "gen:shortlinks": "node --env-file=.env scripts/gen-shortlinks.mjs",
    "migrate:shortlinks": "node --env-file=.env scripts/migrate-shortlinks.mjs",
    "gen:signs": "node scripts/gen-signs.mjs",
    "publish": "npm run build && npm run gen:shortlinks && npm run gen:signs"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.1.13",
    "astro": "^5.14.1",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.13"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0"
  }
}
