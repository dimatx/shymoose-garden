---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import type { IconName } from "../../components/Icon.astro";

export async function getStaticPaths() {
  const plants = await getCollection("plants");
  return plants.map((plant) => ({
    params: { slug: plant.id },
    props: { plant },
  }));
}

const { plant } = Astro.props;
const { Content } = await render(plant);
const {
  name,
  latinName,
  type,
  nativeRange,
  photo,
  photoAlt,
  photoCredit,
  shortDescription,
  care,
  tags,
  learnMoreUrl,
} = plant.data;

// Use the plant's own photo as the social-share image so links shared from a
// phone (e.g. texting someone a plant) show a real preview. A 1200×630 JPEG is
// the most widely supported Open Graph format/size.
const ogImage = await getImage({
  src: photo,
  width: 1200,
  height: 630,
  format: "jpeg",
});

// Two skimmable groups. "Habitat & form" answers the casual question
// "what is this plant and where's it from?"; "Care" is for people who
// actually want to grow it. Each section is hidden if it has no content.
type CareSection = {
  title: string;
  blurb: string;
  items: { label: string; value: string | undefined; icon: IconName }[];
};

const sections = (
  [
    {
      title: "Habitat & form",
      blurb: "Where it's from and what to expect.",
      items: [
        { label: "Native range", value: nativeRange, icon: "globe" },
        { label: "Plant type", value: type, icon: "leaf" },
        { label: "Mature size", value: care.size, icon: "ruler" },
        { label: "Bloom", value: care.bloom, icon: "flower" },
        { label: "Hardiness", value: care.hardiness, icon: "snow" },
      ],
    },
    {
      title: "Care",
      blurb: "How to keep it happy.",
      items: [
        { label: "Sunlight", value: care.sunlight, icon: "sun" },
        { label: "Water", value: care.water, icon: "water" },
        { label: "Soil", value: care.soil, icon: "soil" },
        { label: "Pruning", value: care.pruning, icon: "scissors" },
      ],
    },
  ] satisfies CareSection[]
)
  .map((section) => ({
    ...section,
    items: section.items.filter((item) => Boolean(item.value)),
  }))
  .filter((section) => section.items.length > 0);
---

<Layout title={name} description={shortDescription} image={ogImage.src} imageAlt={photoAlt}>
  <a
    href="/"
    class="mb-5 inline-flex items-center gap-1.5 text-sm font-medium text-leaf-600 transition hover:text-leaf-800 dark:text-leaf-400 dark:hover:text-leaf-200"
  >
    <Icon name="chevron-left" class="h-4 w-4" strokeWidth={2} />
    All plants
  </a>

  <article>
    <figure
      class="overflow-hidden rounded-3xl border border-leaf-200/80 bg-leaf-100 shadow-sm dark:border-leaf-800/80 dark:bg-leaf-800"
    >
      <Image
        src={photo}
        alt={photoAlt || name}
        width={1200}
        height={800}
        widths={[480, 768, 1200]}
        sizes="(min-width: 768px) 768px, 100vw"
        quality={75}
        loading="eager"
        fetchpriority="high"
        transition:name={`plant-photo-${plant.id}`}
        class="aspect-3/2 w-full object-cover"
      />
      {
        photoCredit && (
          <figcaption class="px-4 py-2 text-xs text-leaf-600 dark:text-leaf-400">
            Photo: {photoCredit}
          </figcaption>
        )
      }
    </figure>

    <header class="mt-6">
      <h1 class="text-balance font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
        {name}
      </h1>
      <p class="mt-1 text-lg italic text-leaf-600 dark:text-leaf-400">
        {latinName}
      </p>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full bg-leaf-100 px-3 py-1 text-xs font-medium text-leaf-700 dark:bg-leaf-900 dark:text-leaf-300">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <section class="mt-5">
      <p class="text-lg leading-relaxed text-leaf-800 dark:text-leaf-200">
        {shortDescription}
      </p>

      <details class="group mt-3">
        <summary
          class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-lg text-sm font-semibold text-leaf-700 transition hover:text-leaf-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:text-leaf-300 dark:hover:text-leaf-100 [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden">Keep reading</span>
          <span class="hidden group-open:inline">Show less</span>
          <Icon name="chevron-down" strokeWidth={2} class="h-4 w-4 transition-transform group-open:rotate-180" />
        </summary>
        <div
          class="prose-garden mt-3 space-y-4 leading-relaxed text-leaf-700 dark:text-leaf-300"
        >
          <Content />
        </div>
      </details>
    </section>

    <section class="mt-8 space-y-8">
      {
        sections.map((section) => (
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="font-serif text-xl font-semibold">{section.title}</h2>
              <p class="hidden text-sm text-leaf-500 dark:text-leaf-400 sm:block">
                {section.blurb}
              </p>
            </div>
            <dl class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
              {section.items.map((item) => (
                <div class="flex gap-3 rounded-2xl border border-leaf-200/80 bg-white p-4 dark:border-leaf-800/80 dark:bg-leaf-900">
                  <span
                    class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-leaf-100 text-leaf-600 dark:bg-leaf-800 dark:text-leaf-300"
                    aria-hidden="true"
                  >
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-leaf-500 dark:text-leaf-400">
                      {item.label}
                    </dt>
                    <dd class="mt-0.5 text-sm text-leaf-800 dark:text-leaf-200">
                      {item.value}
                    </dd>
                  </div>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </section>

    {
      learnMoreUrl && (
        <section class="mt-8">
          <a
            href={learnMoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full bg-leaf-600 px-5 py-2.5 text-sm font-semibold text-leaf-50 shadow-sm transition hover:bg-leaf-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:bg-leaf-500 dark:hover:bg-leaf-400"
          >
            Learn more
            <Icon name="arrow-up-right" class="h-4 w-4" strokeWidth={2} />
          </a>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .prose-garden :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.25rem;
  }
  .prose-garden :global(a) {
    color: var(--color-leaf-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-garden :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-garden :global(strong) {
    color: inherit;
    font-weight: 600;
  }
</style>
