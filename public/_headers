# Security headers for all routes
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), microphone=(), camera=(self)

# Hashed, immutable build assets — cache hard
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — serve stale instantly, revalidate in background (stale-while-revalidate)
# Cached pages may be reused during background revalidation for up to 60 s.
/404.html
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/plants/*
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/map
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/map/
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/bloom
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/bloom/
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/pruning
  Cache-Control: public, max-age=0, stale-while-revalidate=60

/pruning/
  Cache-Control: public, max-age=0, stale-while-revalidate=60
