---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import ThemeToggle from "../components/ThemeToggle.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative URL of a social-share image. */
  image?: string;
  /** Alt text describing the share image. */
  imageAlt?: string;
}

const {
  title,
  description = "A living catalog of the plants in the ShyMoose garden. Scan, learn, grow.",
  image,
  imageAlt,
} = Astro.props;

const siteName = "ShyMoose Garden";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#27592c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d2010" media="(prefers-color-scheme: dark)" />

    <!-- Buttery client-side morphs between pages (e.g. card → detail photo). -->
    <ClientRouter />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!-- Set theme before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body
    class="app-bg min-h-full bg-leaf-50 font-sans text-leaf-950 antialiased transition-colors dark:bg-leaf-950 dark:text-leaf-50"
  >
    <header
      class="sticky top-0 z-40 border-b border-leaf-200/70 bg-leaf-50/80 backdrop-blur-md dark:border-leaf-800/70 dark:bg-leaf-950/80"
    >
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a
          href="/"
          class="group flex items-center gap-2 font-serif text-lg font-semibold tracking-tight"
        >
          <span
            class="grid h-9 w-9 place-items-center rounded-full bg-leaf-600 text-leaf-50 shadow-sm transition-transform group-hover:scale-105 dark:bg-leaf-500"
            aria-hidden="true"
          >
            <Icon name="sprout" class="h-5 w-5" />
          </span>
          <span>ShyMoose Garden</span>
        </a>
        <div class="flex items-center gap-1.5">
          <!-- Desktop: inline links with full text. -->
          <a
            href="/bloom/"
            class="hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800 sm:inline-flex"
          >
            <Icon name="bloom" class="h-4 w-4" />
            <span>Bloom calendar</span>
          </a>
          <a
            href="/pruning/"
            class="hidden items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800 sm:inline-flex"
          >
            <Icon name="scissors" class="h-4 w-4" />
            <span>Pruning calendar</span>
          </a>

          <!-- Mobile: a menu button revealing the same links with full text. -->
          <div class="relative sm:hidden">
            <button
              id="nav-menu-button"
              type="button"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="nav-menu"
              aria-label="Open menu"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800"
            >
              <Icon name="menu" class="h-5 w-5" />
            </button>
            <div
              id="nav-menu"
              role="menu"
              aria-labelledby="nav-menu-button"
              hidden
              class="absolute right-0 top-full z-50 mt-2 min-w-52 overflow-hidden rounded-2xl border border-leaf-200/80 bg-white p-1.5 shadow-lg dark:border-leaf-800/80 dark:bg-leaf-900"
            >
              <a
                href="/bloom/"
                role="menuitem"
                class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-100 dark:text-leaf-200 dark:hover:bg-leaf-800"
              >
                <Icon name="bloom" class="h-4 w-4 shrink-0" />
                <span>Bloom calendar</span>
              </a>
              <a
                href="/pruning/"
                role="menuitem"
                class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-100 dark:text-leaf-200 dark:hover:bg-leaf-800"
              >
                <Icon name="scissors" class="h-4 w-4 shrink-0" />
                <span>Pruning calendar</span>
              </a>
            </div>
          </div>

          <!-- Scanning a QR with the camera only makes sense on a phone, so
               this button is hidden on larger (sm+) screens. -->
          <button
            id="qr-scan-button"
            type="button"
            aria-label="Scan plant QR code"
            class="inline-flex h-9 w-9 items-center justify-center rounded-full text-leaf-700 transition hover:bg-leaf-100 dark:text-leaf-300 dark:hover:bg-leaf-800 sm:hidden"
          >
            <Icon name="qr-scan" class="h-5 w-5" />
          </button>

          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl px-4 pb-20 pt-6 sm:px-6">
      <slot />
    </main>

    <footer
      class="mx-auto max-w-3xl px-4 pb-10 text-center text-sm text-leaf-600 dark:text-leaf-400 sm:px-6"
    >
      <p>🌿 Grown with care in the ShyMoose garden.</p>
    </footer>

    <script>
      // Mobile navigation menu: toggle open/closed, and close on outside
      // click, Escape, or when navigating. Re-bound after each view
      // transition (astro:page-load) using a dataset guard so we never
      // attach duplicate listeners.
      function initNavMenu() {
        const button = document.getElementById("nav-menu-button");
        const menu = document.getElementById("nav-menu");
        if (!button || !menu) return;

        const open = () => {
          menu.hidden = false;
          button.setAttribute("aria-expanded", "true");
          button.setAttribute("aria-label", "Close menu");
        };
        const close = () => {
          menu.hidden = true;
          button.setAttribute("aria-expanded", "false");
          button.setAttribute("aria-label", "Open menu");
        };
        const toggle = () => (menu.hidden ? open() : close());

        if (button.dataset.bound !== "true") {
          button.dataset.bound = "true";

          button.addEventListener("click", (e) => {
            e.stopPropagation();
            toggle();
          });

          // Close when clicking anywhere outside the menu.
          document.addEventListener("click", (e) => {
            if (
              !menu.hidden &&
              !menu.contains(e.target as Node) &&
              e.target !== button
            ) {
              close();
            }
          });

          // Close on Escape and return focus to the button.
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !menu.hidden) {
              close();
              button.focus();
            }
          });
        }

        // Always start closed on (re)bind / navigation.
        close();
      }

      initNavMenu();
      document.addEventListener("astro:page-load", initNavMenu);
    </script>
    <!-- QR Scanner Overlay -->
    <div
      id="qr-overlay"
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Scan plant QR code"
      class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-black"
    >
      <video
        id="qr-video"
        class="absolute inset-0 h-full w-full object-cover"
        playsinline
        muted
      ></video>
      <canvas id="qr-canvas" class="hidden"></canvas>

      <!-- Viewfinder: box-shadow dims everything outside the scan area -->
      <div class="pointer-events-none relative z-10 flex flex-col items-center">
        <div
          class="relative h-56 w-56 rounded-lg"
          style="box-shadow: 0 0 0 9999px rgba(0,0,0,0.55);"
        >
          <!-- Corner brackets -->
          <svg
            class="absolute inset-0 h-full w-full text-white"
            viewBox="0 0 100 100"
            fill="none"
            stroke="currentColor"
            stroke-width="5"
            stroke-linecap="round"
          >
            <path d="M10 30 L10 10 L30 10" />
            <path d="M70 10 L90 10 L90 30" />
            <path d="M90 70 L90 90 L70 90" />
            <path d="M30 90 L10 90 L10 70" />
          </svg>
          <!-- Animated scan line -->
          <div
            id="qr-scan-line"
            class="absolute left-1 right-1 h-px rounded-full bg-green-400"
            style="top: 50%; box-shadow: 0 0 6px 2px rgba(74,222,128,0.7);"
          ></div>
        </div>
        <p id="qr-status" class="mt-5 text-sm text-white/70">
          Point at a plant QR code
        </p>
      </div>

      <!-- Close button -->
      <button
        id="qr-close"
        type="button"
        aria-label="Close QR scanner"
        class="absolute right-4 top-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur-sm transition hover:bg-black/70"
      >
        <Icon name="x" class="h-5 w-5" />
      </button>
    </div>

    <script>
      // jsQR is ~125 KB — far too heavy to ship on every page when the
      // scanner is a rarely-used, mobile-only feature. Load it lazily the
      // first time someone opens the scanner so the catalog and plant detail
      // pages stay light and navigate instantly.
      import type jsQRType from "jsqr";
      let jsQR: typeof jsQRType | null = null;

      function initQRScanner() {
        const button = document.getElementById("qr-scan-button");
        const overlay = document.getElementById("qr-overlay");
        const video = document.getElementById("qr-video") as HTMLVideoElement | null;
        const canvas = document.getElementById("qr-canvas") as HTMLCanvasElement | null;
        const closeBtn = document.getElementById("qr-close");
        const statusEl = document.getElementById("qr-status");
        const scanLine = document.getElementById("qr-scan-line");

        if (!button || !overlay || !video || !canvas || !closeBtn) return;
        if (button.dataset.bound === "true") return;
        button.dataset.bound = "true";

        let stream: MediaStream | null = null;
        let animFrame: number | null = null;
        let scanLinePos = 50;
        let scanLineDir = 1;

        const ctx = canvas.getContext("2d")!;

        async function openScanner() {
          overlay.hidden = false;
          document.body.style.overflow = "hidden";
          if (statusEl) statusEl.textContent = "Point at a plant QR code";

          // getUserMedia only exists in secure contexts (https or localhost).
          if (!navigator.mediaDevices?.getUserMedia) {
            if (statusEl)
              statusEl.textContent =
                "Camera needs a secure (https) connection.";
            return;
          }

          // Fetch the decoder on demand — this downloads/parses in parallel
          // with the user granting camera permission, so it adds no perceived
          // delay while keeping it out of the every-page bundle.
          if (!jsQR) {
            try {
              jsQR = (await import("jsqr")).default;
            } catch {
              if (statusEl)
                statusEl.textContent = "Couldn't load the QR scanner.";
              return;
            }
          }

          try {
            stream = await navigator.mediaDevices.getUserMedia({
              video: { facingMode: { ideal: "environment" } },
            });
            video.srcObject = stream;
            await video.play();
            animFrame = requestAnimationFrame(tick);
          } catch (err) {
            const name = (err as Error)?.name;
            if (statusEl)
              statusEl.textContent =
                name === "NotAllowedError" || name === "SecurityError"
                  ? "Camera blocked. Allow camera access in your browser settings, then try again."
                  : name === "NotFoundError" || name === "OverconstrainedError"
                    ? "No camera found on this device."
                    : name === "NotReadableError"
                      ? "Camera is in use by another app."
                      : "Couldn't start the camera.";
          }
        }

        function closeScanner() {
          overlay.hidden = true;
          document.body.style.overflow = "";
          if (animFrame !== null) {
            cancelAnimationFrame(animFrame);
            animFrame = null;
          }
          if (stream) {
            stream.getTracks().forEach((t) => t.stop());
            stream = null;
          }
          video.srcObject = null;
        }

        function tick() {
          if (overlay.hidden) return;

          if (scanLine) {
            scanLinePos += scanLineDir * 0.6;
            if (scanLinePos > 82) scanLineDir = -1;
            if (scanLinePos < 18) scanLineDir = 1;
            scanLine.style.top = `${scanLinePos}%`;
          }

          if (video.readyState === video.HAVE_ENOUGH_DATA && jsQR) {
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const code = jsQR(imageData.data, imageData.width, imageData.height, {
              inversionAttempts: "dontInvert",
            });

            if (code) {
              closeScanner();
              try {
                const url = new URL(code.data);
                if (url.protocol === "https:" || url.protocol === "http:") {
                  window.location.href = url.href;
                }
              } catch {
                // Not a URL — ignore
              }
              return;
            }
          }

          animFrame = requestAnimationFrame(tick);
        }

        button.addEventListener("click", openScanner);
        closeBtn.addEventListener("click", closeScanner);
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !overlay.hidden) closeScanner();
        });
        // Stop the camera stream on view-transition navigations.
        document.addEventListener("astro:before-preparation", closeScanner);
      }

      initQRScanner();
      document.addEventListener("astro:page-load", initQRScanner);
    </script>
  </body>
</html>
