---
/**
 * Single source of truth for every inline SVG icon used across the site.
 * Add a new icon by adding one entry to `ICONS` below, then use it anywhere
 * with `<Icon name="your-icon" />`.
 *
 * Each entry is the *inner* markup of a 24×24, currentColor, stroke-based
 * icon (the `<svg>` wrapper and shared attributes are added here). These
 * strings are static and authored in this repo — never user input — so
 * rendering them with `set:html` is safe.
 */
const ICONS = {
  // Brand / navigation
  sprout: `<path d="M12 21c0-5 0-8 0-11" /><path d="M12 13c-3.5 0-6-2.2-6-6 3.6 0 6 2.2 6 6Z" /><path d="M12 10c.2-3.2 2.5-5.5 6-5.5-.2 3.2-2.5 5.5-6 5.5Z" />`,
  bloom: `<path d="M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1" /><circle cx="12" cy="8" r="2" /><path d="M12 10v12" /><path d="M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z" /><path d="M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z" />`,
  clock: `<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />`,

  // UI controls
  sun: `<circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />`,
  moon: `<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />`,
  search: `<circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />`,
  "filter-type": `<path d="M12 2a7 7 0 0 0-7 7c0 3 2 5 3.5 7.5C9.5 18 10 20 12 22c2-2 2.5-4 3.5-5.5C17 14 19 12 19 9a7 7 0 0 0-7-7Z" />`,
  tag: `<path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L3 13V3h10l7.59 7.59a2 2 0 0 1 0 2.82Z" /><circle cx="7.5" cy="7.5" r="1.5" />`,
  "chevron-down": `<path d="M6 9l6 6 6-6" />`,
  "chevron-left": `<path d="M15 18l-6-6 6-6" />`,
  "arrow-up-right": `<path d="M7 17L17 7M9 7h8v8" />`,

  // Plant care details (names match the `icon` values in [slug].astro)
  globe: `<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18" />`,
  leaf: `<path d="M11 20A7 7 0 0 1 4 13c0-5 4.5-9 16-9 0 7-4 16-9 16Z" /><path d="M11 20c0-5 2-9 5-12" />`,
  water: `<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z" />`,
  soil: `<path d="M3 16h18M3 20h18" /><path d="M8 12c0-2 1.8-3 4-3s4 1 4 3" /><path d="M12 9V5" />`,
  snow: `<path d="M12 2v20M4 7l16 10M20 7L4 17M12 2l-3 3M12 2l3 3M12 22l-3-3M12 22l3-3" />`,
  ruler: `<rect x="3" y="8" width="18" height="8" rx="1" /><path d="M7 8v3M11 8v4M15 8v3M19 8v4" />`,
  flower: `<circle cx="12" cy="9" r="2.5" /><path d="M12 6.5C12 4 10.5 3 12 3s.5 1 0 3.5M12 11.5c0 2.5 1.5 3.5 0 3.5s-.5-1 0-3.5" /><path d="M9.5 9C7 9 6 10.5 6 9s1-.5 3.5 0M14.5 9c2.5 0 3.5-1.5 3.5 0s-1 .5-3.5 0" /><path d="M12 14v7" />`,
  scissors: `<circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12" />`,
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  /** Tailwind/size classes for the `<svg>`. Defaults to `h-5 w-5`. */
  class?: string;
  /** Stroke width. Most icons use 1.8; thin line icons read better at 2. */
  strokeWidth?: number;
}

const { name, class: className = "h-5 w-5", strokeWidth = 1.8 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
></svg>
