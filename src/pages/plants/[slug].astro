---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const plants = await getCollection("plants");
  return plants.map((plant) => ({
    params: { slug: plant.id },
    props: { plant },
  }));
}

const { plant } = Astro.props;
const { Content } = await render(plant);
const {
  name,
  latinName,
  photo,
  photoAlt,
  photoCredit,
  shortDescription,
  care,
  tags,
  learnMoreUrl,
} = plant.data;

const careItems = [
  { label: "Water", value: care.water, icon: "water" },
  { label: "Soil", value: care.soil, icon: "soil" },
  { label: "Sunlight", value: care.sunlight, icon: "sun" },
  { label: "Hardiness", value: care.hardiness, icon: "snow" },
  { label: "Size", value: care.size, icon: "ruler" },
  { label: "Bloom", value: care.bloom, icon: "flower" },
  { label: "Pruning", value: care.pruning, icon: "scissors" },
].filter((item) => Boolean(item.value));
---

<Layout title={name} description={shortDescription}>
  <a
    href="/"
    class="mb-5 inline-flex items-center gap-1.5 text-sm font-medium text-leaf-600 transition hover:text-leaf-800 dark:text-leaf-400 dark:hover:text-leaf-200"
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 18l-6-6 6-6" />
    </svg>
    All plants
  </a>

  <article>
    <figure
      class="overflow-hidden rounded-3xl border border-leaf-200/80 bg-leaf-100 shadow-sm dark:border-leaf-800/80 dark:bg-leaf-800"
    >
      <Image
        src={photo}
        alt={photoAlt || name}
        width={1200}
        height={800}
        widths={[480, 768, 1200]}
        sizes="(min-width: 768px) 768px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[3/2] w-full object-cover"
      />
      {
        photoCredit && (
          <figcaption class="px-4 py-2 text-xs text-leaf-600 dark:text-leaf-400">
            Photo: {photoCredit}
          </figcaption>
        )
      }
    </figure>

    <header class="mt-6">
      <h1 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
        {name}
      </h1>
      <p class="mt-1 text-lg italic text-leaf-600 dark:text-leaf-400">
        {latinName}
      </p>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full bg-leaf-100 px-3 py-1 text-xs font-medium text-leaf-700 dark:bg-leaf-900 dark:text-leaf-300">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <section class="mt-5">
      <p class="text-lg leading-relaxed text-leaf-800 dark:text-leaf-200">
        {shortDescription}
      </p>

      <details class="group mt-3">
        <summary
          class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-lg text-sm font-semibold text-leaf-700 transition hover:text-leaf-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:text-leaf-300 dark:hover:text-leaf-100 [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden">Keep reading</span>
          <span class="hidden group-open:inline">Show less</span>
          <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div
          class="prose-garden mt-3 space-y-4 leading-relaxed text-leaf-700 dark:text-leaf-300"
        >
          <Content />
        </div>
      </details>
    </section>

    <section class="mt-8">
      <h2 class="font-serif text-xl font-semibold">Care</h2>
      <dl class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {
          careItems.map((item) => (
            <div class="flex gap-3 rounded-2xl border border-leaf-200/80 bg-white p-4 dark:border-leaf-800/80 dark:bg-leaf-900">
              <span
                class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-full bg-leaf-100 text-leaf-600 dark:bg-leaf-800 dark:text-leaf-300"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  {item.icon === "water" && (
                    <path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z" />
                  )}
                  {item.icon === "soil" && (
                    <>
                      <path d="M3 16h18M3 20h18" />
                      <path d="M8 12c0-2 1.8-3 4-3s4 1 4 3" />
                      <path d="M12 9V5" />
                    </>
                  )}
                  {item.icon === "sun" && (
                    <>
                      <circle cx="12" cy="12" r="4" />
                      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </>
                  )}
                  {item.icon === "snow" && (
                    <path d="M12 2v20M4 7l16 10M20 7L4 17M12 2l-3 3M12 2l3 3M12 22l-3-3M12 22l3-3" />
                  )}
                  {item.icon === "ruler" && (
                    <>
                      <rect x="3" y="8" width="18" height="8" rx="1" />
                      <path d="M7 8v3M11 8v4M15 8v3M19 8v4" />
                    </>
                  )}
                  {item.icon === "flower" && (
                    <>
                      <circle cx="12" cy="9" r="2.5" />
                      <path d="M12 6.5C12 4 10.5 3 12 3s.5 1 0 3.5M12 11.5c0 2.5 1.5 3.5 0 3.5s-.5-1 0-3.5" />
                      <path d="M9.5 9C7 9 6 10.5 6 9s1-.5 3.5 0M14.5 9c2.5 0 3.5-1.5 3.5 0s-1 .5-3.5 0" />
                      <path d="M12 14v7" />
                    </>
                  )}
                  {item.icon === "scissors" && (
                    <>
                      <circle cx="6" cy="6" r="3" />
                      <circle cx="6" cy="18" r="3" />
                      <path d="M20 4L8.12 15.88M14.47 14.48L20 20M8.12 8.12L12 12" />
                    </>
                  )}
                </svg>
              </span>
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-leaf-500 dark:text-leaf-400">
                  {item.label}
                </dt>
                <dd class="mt-0.5 text-sm text-leaf-800 dark:text-leaf-200">
                  {item.value}
                </dd>
              </div>
            </div>
          ))
        }
      </dl>
    </section>

    {
      learnMoreUrl && (
        <section class="mt-8">
          <a
            href={learnMoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full bg-leaf-600 px-5 py-2.5 text-sm font-semibold text-leaf-50 shadow-sm transition hover:bg-leaf-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:bg-leaf-500 dark:hover:bg-leaf-400"
          >
            Learn more
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17L17 7M9 7h8v8" />
            </svg>
          </a>
        </section>
      )
    }
  </article>
</Layout>

<style>
  .prose-garden :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 1.25rem;
  }
  .prose-garden :global(a) {
    color: var(--color-leaf-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-garden :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-garden :global(strong) {
    color: inherit;
    font-weight: 600;
  }
</style>
