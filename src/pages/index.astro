---
import Layout from "../layouts/Layout.astro";
import PlantCard from "../components/PlantCard.astro";
import Icon from "../components/Icon.astro";
import { getSortedPlants } from "../lib/plants";

const plants = await getSortedPlants();

// Plant-type filters are built straight from the data, so adding a new `type`
// to a plant automatically gives it a filter button — no code changes needed.
const types = [
  ...new Set(plants.map((p) => p.data.type).filter((t): t is string => !!t)),
].sort((a, b) => a.localeCompare(b));

// Characteristic filters come from the free-form `tags`. We offer a curated
// shortlist and only show the ones that actually appear on a plant.
const traitCandidates = [
  "Evergreen",
  "Drought tolerant",
  "Pollinator friendly",
  "Low maintenance",
  "Edible",
  "Deer & rabbit resistant",
  "Shade garden",
];
const allTags = new Set(plants.flatMap((p) => p.data.tags));
const traits = traitCandidates.filter((t) => allTags.has(t));

const hasFilters = types.length > 0 || traits.length > 0;
---

<Layout title="ShyMoose Garden">
  <section class="mb-6">
    <h1 class="text-balance font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      The Garden
    </h1>
    <p class="mt-2 max-w-prose text-pretty text-leaf-700 dark:text-leaf-300">
      A living catalog of everything growing here. Pick a plant to dig into its
      story, quirks, and what keeps it happy.
    </p>
  </section>

  <div class="mb-4">
    <label class="relative block">
      <span class="sr-only">Search plants by name</span>
      <Icon
        name="search"
        strokeWidth={2}
        class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-leaf-500 dark:text-leaf-400"
      />
      <input
        type="search"
        id="plant-search"
        placeholder="Search plants by name…"
        autocomplete="off"
        class="w-full rounded-full border border-leaf-300 bg-white py-2.5 pl-10 pr-4 text-sm text-leaf-900 placeholder:text-leaf-500 focus:border-leaf-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-leaf-500/40 dark:border-leaf-700 dark:bg-leaf-900 dark:text-leaf-50 dark:placeholder:text-leaf-400"
      />
    </label>
  </div>

  {
    hasFilters && (
      <div class="mb-6 flex flex-wrap items-center gap-3">
        {types.length > 0 && (
          <details class="filter-dd relative">
            <summary class="filter-trigger">
              <Icon name="filter-type" class="h-4 w-4" />
              Type
              <span class="filter-badge hidden">0</span>
              <Icon name="chevron-down" strokeWidth={2} class="filter-caret h-3.5 w-3.5" />
            </summary>
            <div class="filter-panel" aria-label="Filter by type">
              {types.map((type) => (
                <button
                  type="button"
                  class="filter-chip"
                  data-filter="type"
                  data-value={type}
                  aria-pressed="false"
                >
                  {type}
                </button>
              ))}
            </div>
          </details>
        )}

        {traits.length > 0 && (
          <details class="filter-dd relative">
            <summary class="filter-trigger">
              <Icon name="tag" class="h-4 w-4" />
              Traits
              <span class="filter-badge hidden">0</span>
              <Icon name="chevron-down" strokeWidth={2} class="filter-caret h-3.5 w-3.5" />
            </summary>
            <div class="filter-panel" aria-label="Filter by trait">
              {traits.map((trait) => (
                <button
                  type="button"
                  class="filter-chip"
                  data-filter="trait"
                  data-value={trait}
                  aria-pressed="false"
                >
                  {trait}
                </button>
              ))}
            </div>
          </details>
        )}

        <p
          id="filter-count"
          class="text-sm text-leaf-600 dark:text-leaf-400"
          aria-live="polite"
        >
          Showing all {plants.length} plants
        </p>

        <button
          type="button"
          id="filter-clear"
          class="hidden text-sm font-medium text-leaf-700 underline-offset-2 hover:underline dark:text-leaf-300"
        >
          Clear filters
        </button>
      </div>
    )
  }

  {
    plants.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-leaf-300 p-8 text-center text-leaf-600 dark:border-leaf-700 dark:text-leaf-400">
        No plants yet — add your first one in <code>src/content/plants/</code>.
      </p>
    ) : (
      <>
        <div id="plant-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {plants.map((plant, i) => (
            <div
              class="plant-item"
              data-name={plant.data.name}
              data-type={plant.data.type ?? ""}
              data-tags={`|${plant.data.tags.join("|")}|`}
            >
              <PlantCard plant={plant} priority={i === 0} />
            </div>
          ))}
        </div>
        <p
          id="no-matches"
          class="hidden rounded-2xl border border-dashed border-leaf-300 p-8 text-center text-leaf-600 dark:border-leaf-700 dark:text-leaf-400"
        >
          No plants match those filters.{" "}
          <button type="button" id="no-matches-clear" class="font-medium underline underline-offset-2">
            Clear filters
          </button>
        </p>
      </>
    )
  }
</Layout>

<style>
  /* Filter chip styling kept here so the buttons look consistent whether or
     not JavaScript has toggled their active state. */
  .filter-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-leaf-300, #b7d3ba);
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .filter-chip[aria-pressed="true"] {
    background-color: var(--color-leaf-600, #3f7a45);
    border-color: var(--color-leaf-600, #3f7a45);
    color: #fff;
  }

  /* Dropdown trigger button (one per filter group). */
  .filter-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    border-radius: 9999px;
    border: 1px solid var(--color-leaf-300, #b7d3ba);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-leaf-800, #2f5e34);
    transition: background-color 0.15s ease;
  }
  .filter-trigger:hover {
    background-color: var(--color-leaf-100, #e3f0e4);
  }
  .filter-trigger::-webkit-details-marker {
    display: none;
  }
  :global(.dark) .filter-trigger {
    border-color: var(--color-leaf-700, #356a3b);
    color: var(--color-leaf-200, #c3e0c6);
  }
  :global(.dark) .filter-trigger:hover {
    background-color: var(--color-leaf-800, #234d28);
  }

  /* Rotate the caret when the dropdown is open. */
  .filter-dd[open] .filter-caret {
    transform: rotate(180deg);
  }
  .filter-caret {
    transition: transform 0.15s ease;
  }

  /* Active-count badge on a trigger. */
  .filter-badge {
    min-width: 1.25rem;
    border-radius: 9999px;
    background-color: var(--color-leaf-600, #3f7a45);
    padding: 0 0.375rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25rem;
    color: #fff;
  }

  /* The dropdown panel that holds the chips. */
  .filter-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: max-content;
    max-width: min(20rem, calc(100vw - 2rem));
    border-radius: 1rem;
    border: 1px solid var(--color-leaf-200, #cfe5d1);
    background-color: #fff;
    padding: 1rem;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }
  :global(.dark) .filter-panel {
    border-color: var(--color-leaf-800, #234d28);
    background-color: var(--color-leaf-900, #16361a);
  }
</style>

<script>
  // Lightweight, no-framework filtering. With JS disabled every plant simply
  // stays visible, so the catalog still works.
  function initCatalog() {
    const grid = document.getElementById("plant-grid");
    if (!grid || grid.dataset.ready) return;
    grid.dataset.ready = "true";

    // Gentle, staggered entrance as cards scroll into view. Classes are added
    // by JS so a no-JS visitor still sees every card immediately.
    const itemEls = Array.from(
      grid.querySelectorAll<HTMLElement>(".plant-item")
    );
    if (
      "IntersectionObserver" in window &&
      window.matchMedia("(prefers-reduced-motion: no-preference)").matches
    ) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        },
        // Reveal cards ~300px before they scroll into view so they're already
        // settling in by the time the user reaches them — no waiting.
        { rootMargin: "0px 0px 300px 0px" }
      );
      itemEls.forEach((el, i) => {
        el.classList.add("reveal");
        // Only the first couple of cards stagger; the rest pop in promptly.
        el.style.transitionDelay = `${Math.min(i, 3) * 45}ms`;
        io.observe(el);
      });
    }

    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-chip")
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".plant-item")
    );
    const countEl = document.getElementById("filter-count");
    const clearEl = document.getElementById("filter-clear");
    const dropdowns = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(".filter-dd")
    );
    const noMatches = document.getElementById("no-matches");
    const noMatchesClear = document.getElementById("no-matches-clear");
    const searchInput = document.getElementById(
      "plant-search"
    ) as HTMLInputElement | null;
    const total = items.length;

    const selectedTypes = new Set<string>();
    const selectedTraits = new Set<string>();
    let searchTerm = "";

    // Update the per-dropdown count badge from its own pressed chips.
    function updateBadges() {
      for (const dd of dropdowns) {
        const badge = dd.querySelector<HTMLElement>(".filter-badge");
        if (!badge) continue;
        const count = dd.querySelectorAll('.filter-chip[aria-pressed="true"]')
          .length;
        badge.textContent = String(count);
        badge.classList.toggle("hidden", count === 0);
      }
    }

    function apply() {
      let visible = 0;
      for (const item of items) {
        const type = item.dataset.type ?? "";
        const tags = item.dataset.tags ?? "";
        const name = (item.dataset.name ?? "").toLowerCase();
        // Types are OR'd (broaden), traits are AND'd (narrow).
        const typeOk = selectedTypes.size === 0 || selectedTypes.has(type);
        const traitOk = [...selectedTraits].every((t) =>
          tags.includes(`|${t}|`)
        );
        const searchOk = searchTerm === "" || name.includes(searchTerm);
        const show = typeOk && traitOk && searchOk;
        item.hidden = !show;
        if (show) visible++;
      }

      const active =
        selectedTypes.size + selectedTraits.size + (searchTerm ? 1 : 0);
      if (countEl) {
        countEl.textContent =
          active === 0
            ? `Showing all ${total} plants`
            : `Showing ${visible} of ${total} plants`;
      }
      if (clearEl) clearEl.classList.toggle("hidden", active === 0);
      updateBadges();
      if (noMatches) noMatches.classList.toggle("hidden", visible !== 0);
    }

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const value = chip.dataset.value ?? "";
        const set =
          chip.dataset.filter === "type" ? selectedTypes : selectedTraits;
        const pressed = chip.getAttribute("aria-pressed") === "true";
        if (pressed) {
          set.delete(value);
          chip.setAttribute("aria-pressed", "false");
        } else {
          set.add(value);
          chip.setAttribute("aria-pressed", "true");
        }
        apply();
      });
    }

    function clearAll() {
      selectedTypes.clear();
      selectedTraits.clear();
      for (const chip of chips) chip.setAttribute("aria-pressed", "false");
      searchTerm = "";
      if (searchInput) searchInput.value = "";
      apply();
    }

    searchInput?.addEventListener("input", () => {
      searchTerm = searchInput.value.trim().toLowerCase();
      apply();
    });

    clearEl?.addEventListener("click", clearAll);
    noMatchesClear?.addEventListener("click", clearAll);

    // Close any open dropdown when clicking outside one, or pressing Escape.
    document.addEventListener("click", (e) => {
      for (const dd of dropdowns) {
        if (dd.open && !dd.contains(e.target as Node)) dd.open = false;
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        for (const dd of dropdowns) dd.open = false;
      }
    });
  }

  initCatalog();
  document.addEventListener("astro:page-load", initCatalog);
</script>
