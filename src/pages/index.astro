---
import Layout from "../layouts/Layout.astro";
import PlantCard from "../components/PlantCard.astro";
import Icon from "../components/Icon.astro";
import { getSortedPlants, sunLevels, SUN_LEVELS } from "../lib/plants";

const plants = await getSortedPlants();

// Plant-type filters are built straight from the data, so adding a new `type`
// to a plant automatically gives it a filter button — no code changes needed.
const types = [
  ...new Set(plants.map((p) => p.data.type).filter((t): t is string => !!t)),
].sort((a, b) => a.localeCompare(b));

// Sun-exposure filters are derived from each plant's `care.sunlight` prose. We
// keep the canonical brightest-to-shadiest order and only show buckets that an
// actual plant falls into.
const suns = SUN_LEVELS.filter((level) =>
  plants.some((p) => sunLevels(p).includes(level))
);

// Characteristic filters come from the free-form `tags`. We offer a curated
// shortlist and only show the ones that actually appear on a plant.
const traitCandidates = [
  "Evergreen",
  "Drought tolerant",
  "Pollinator friendly",
  "Low maintenance",
  "Edible",
  "Deer resistant",
  "Shade garden",
];
const allTags = new Set(plants.flatMap((p) => p.data.tags));
const traits = traitCandidates.filter((t) => allTags.has(t));

const hasFilters = types.length > 0 || traits.length > 0 || suns.length > 0;
---

<Layout title="ShyMoose Garden">
  <section class="mb-6">
    <h1 class="text-balance font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      The Garden
    </h1>
    <p class="mt-2 max-w-prose text-pretty text-leaf-700 dark:text-leaf-300">
      A living catalog of everything growing here. Pick a plant to dig into its
      story, quirks, and what keeps it happy.
    </p>
  </section>

  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center">
    <label class="relative block flex-1">
      <span class="sr-only">Search plants by common or Latin name</span>
      <Icon
        name="search"
        strokeWidth={2}
        class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-leaf-500 dark:text-leaf-400"
      />
      <input
        type="search"
        id="plant-search"
        placeholder="Search plants by name or Latin name…"
        autocomplete="off"
        class="w-full rounded-full border border-leaf-300 bg-white py-2.5 pl-10 pr-4 text-sm text-leaf-900 placeholder:text-leaf-500 focus:border-leaf-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-leaf-500/40 dark:border-leaf-700 dark:bg-leaf-900 dark:text-leaf-50 dark:placeholder:text-leaf-400"
      />
    </label>
    <details id="plant-sort" class="filter-dd relative shrink-0 self-start sm:self-auto">
      <summary class="filter-trigger">
        <Icon name="sort" class="h-4 w-4" />
        <span>Sort by: <span id="plant-sort-label">Name (A–Z)</span></span>
        <Icon name="chevron-down" strokeWidth={2} class="filter-caret h-3.5 w-3.5" />
      </summary>
      <div class="filter-panel sort-panel" role="group" aria-label="Sort plants by">
        <button type="button" class="filter-chip" data-sort="name" aria-pressed="true">
          Name (A–Z)
        </button>
        <button type="button" class="filter-chip" data-sort="recent" aria-pressed="false">
          Recently added
        </button>
      </div>
    </details>
  </div>

  {
    hasFilters && (
      <div class="mb-6 flex flex-wrap items-center gap-3">
        {types.length > 0 && (
          <details class="filter-dd relative">
            <summary class="filter-trigger">
              <Icon name="filter-type" class="h-4 w-4" />
              Type
              <span class="filter-badge hidden">0</span>
              <Icon name="chevron-down" strokeWidth={2} class="filter-caret h-3.5 w-3.5" />
            </summary>
            <div class="filter-panel" aria-label="Filter by type">
              {types.map((type) => (
                <button
                  type="button"
                  class="filter-chip"
                  data-filter="type"
                  data-value={type}
                  aria-pressed="false"
                >
                  {type}
                </button>
              ))}
            </div>
          </details>
        )}

        {suns.length > 0 && (
          <details class="filter-dd relative">
            <summary class="filter-trigger">
              <Icon name="sun" class="h-4 w-4" />
              Sun
              <span class="filter-badge hidden">0</span>
              <Icon name="chevron-down" strokeWidth={2} class="filter-caret h-3.5 w-3.5" />
            </summary>
            <div class="filter-panel" aria-label="Filter by sun exposure">
              {suns.map((sun) => (
                <button
                  type="button"
                  class="filter-chip"
                  data-filter="sun"
                  data-value={sun}
                  aria-pressed="false"
                >
                  {sun}
                </button>
              ))}
            </div>
          </details>
        )}

        {traits.length > 0 && (
          <details class="filter-dd relative">
            <summary class="filter-trigger">
              <Icon name="tag" class="h-4 w-4" />
              Traits
              <span class="filter-badge hidden">0</span>
              <Icon name="chevron-down" strokeWidth={2} class="filter-caret h-3.5 w-3.5" />
            </summary>
            <div class="filter-panel" aria-label="Filter by trait">
              {traits.map((trait) => (
                <button
                  type="button"
                  class="filter-chip"
                  data-filter="trait"
                  data-value={trait}
                  aria-pressed="false"
                >
                  {trait}
                </button>
              ))}
            </div>
          </details>
        )}

        <p
          id="filter-count"
          class="text-sm text-leaf-600 dark:text-leaf-400"
          aria-live="polite"
        >
          Showing all {plants.length} plants
        </p>

        <button
          type="button"
          id="filter-clear"
          class="hidden text-sm font-medium text-leaf-700 underline-offset-2 hover:underline dark:text-leaf-300"
        >
          Clear filters
        </button>
      </div>
    )
  }

  <div id="active-tag-bar" class="mb-4 hidden flex-wrap items-center gap-2">
    <span class="text-sm text-leaf-600 dark:text-leaf-400">Filtered by tag:</span>
    <button
      type="button"
      id="active-tag-clear"
      class="inline-flex items-center gap-1.5 rounded-full bg-leaf-600 px-3 py-1 text-sm font-medium text-white transition hover:bg-leaf-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-leaf-500 dark:bg-leaf-500 dark:hover:bg-leaf-400"
    >
      <span id="active-tag-label"></span>
      <span aria-hidden="true" class="text-base leading-none">×</span>
      <span class="sr-only">Remove tag filter</span>
    </button>
  </div>

  {
    plants.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-leaf-300 p-8 text-center text-leaf-600 dark:border-leaf-700 dark:text-leaf-400">
        No plants yet — add your first one in <code>src/content/plants/</code>.
      </p>
    ) : (
      <>
        <div id="plant-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {plants.map((plant, i) => (
            <div
              class="plant-item"
              data-name={plant.data.name}
              data-latin={plant.data.latinName}
              data-added={plant.data.dateAdded?.getTime() ?? 0}
              data-type={plant.data.type ?? ""}
              data-sun={`|${sunLevels(plant).join("|")}|`}
              data-tags={`|${plant.data.tags.join("|")}|`}
            >
              <PlantCard plant={plant} priority={i === 0} eager={i === 1} />
            </div>
          ))}
        </div>
        <p
          id="no-matches"
          class="hidden rounded-2xl border border-dashed border-leaf-300 p-8 text-center text-leaf-600 dark:border-leaf-700 dark:text-leaf-400"
        >
          No plants match those filters.{" "}
          <button type="button" id="no-matches-clear" class="font-medium underline underline-offset-2">
            Clear filters
          </button>
        </p>
      </>
    )
  }
</Layout>

<style>
  /* Filter chip styling kept here so the buttons look consistent whether or
     not JavaScript has toggled their active state. */
  .filter-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-leaf-300, #b7d3ba);
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .filter-chip[aria-pressed="true"] {
    background-color: var(--color-leaf-600, #3f7a45);
    border-color: var(--color-leaf-600, #3f7a45);
    color: #fff;
  }

  /* Dropdown trigger button (one per filter group). */
  .filter-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    border-radius: 9999px;
    border: 1px solid var(--color-leaf-300, #b7d3ba);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-leaf-800, #2f5e34);
    transition: background-color 0.15s ease;
  }
  .filter-trigger:hover {
    background-color: var(--color-leaf-100, #e3f0e4);
  }
  .filter-trigger::-webkit-details-marker {
    display: none;
  }
  :global(.dark) .filter-trigger {
    border-color: var(--color-leaf-700, #356a3b);
    color: var(--color-leaf-200, #c3e0c6);
  }
  :global(.dark) .filter-trigger:hover {
    background-color: var(--color-leaf-800, #234d28);
  }

  /* Rotate the caret when the dropdown is open. */
  .filter-dd[open] .filter-caret {
    transform: rotate(180deg);
  }
  .filter-caret {
    transition: transform 0.15s ease;
  }

  /* Active-count badge on a trigger. */
  .filter-badge {
    min-width: 1.25rem;
    border-radius: 9999px;
    background-color: var(--color-leaf-600, #3f7a45);
    padding: 0 0.375rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25rem;
    color: #fff;
  }

  /* The dropdown panel that holds the chips. */
  .filter-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: max-content;
    max-width: min(20rem, calc(100vw - 2rem));
    border-radius: 1rem;
    border: 1px solid var(--color-leaf-200, #cfe5d1);
    background-color: #fff;
    padding: 1rem;
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
  }
  :global(.dark) .filter-panel {
    border-color: var(--color-leaf-800, #234d28);
    background-color: var(--color-leaf-900, #16361a);
  }
  .sort-panel {
    flex-direction: column;
    align-items: flex-start;
  }
  @media (min-width: 640px) {
    .sort-panel {
      left: auto;
      right: 0;
    }
  }
</style>

<script>
  import { isTransitionBeforeSwapEvent } from "astro:transitions/client";

  type CatalogState = {
    search: string;
    types: string[];
    traits: string[];
    suns: string[];
    tag: string;
    sort: string;
  };

  // Module memory survives ClientRouter navigation, but not reloads or new
  // visits. Only a direct list -> detail -> list trip restores this snapshot.
  let catalogState: CatalogState | undefined;
  let detailReturnState: CatalogState | undefined;
  let restoreState: CatalogState | undefined;

  document.addEventListener("astro:before-swap", (event) => {
    if (!isTransitionBeforeSwapEvent(event)) return;
    const toDetail = /^\/plants\/[^/]+\/?$/.test(event.to.pathname);
    const fromDetail = /^\/plants\/[^/]+\/?$/.test(event.from.pathname);
    restoreState = undefined;
    if (event.from.pathname === "/" && toDetail) {
      detailReturnState = catalogState;
    } else if (
      fromDetail &&
      event.to.pathname === "/" &&
      (event.navigationType === "traverse" || event.to.search === "")
    ) {
      restoreState = detailReturnState;
      detailReturnState = undefined;
    } else {
      detailReturnState = undefined;
    }
    catalogState = undefined;
  });

  // Lightweight, no-framework filtering. With JS disabled every plant simply
  // stays visible, so the catalog still works.
  function initCatalog() {
    const grid = document.getElementById("plant-grid");
    if (!grid || grid.dataset.ready) return;
    grid.dataset.ready = "true";

    // Gentle, staggered entrance as cards scroll into view. Classes are added
    // by JS so a no-JS visitor still sees every card immediately.
    const itemEls = Array.from(
      grid.querySelectorAll<HTMLElement>(".plant-item")
    );
    if (
      "IntersectionObserver" in window &&
      window.matchMedia("(prefers-reduced-motion: no-preference)").matches
    ) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        },
        // Reveal cards ~300px before they scroll into view so they're already
        // settling in by the time the user reaches them — no waiting.
        { rootMargin: "0px 0px 300px 0px" }
      );
      itemEls.forEach((el, i) => {
        el.classList.add("reveal");
        // Only the first couple of cards stagger; the rest pop in promptly.
        el.style.transitionDelay = `${Math.min(i, 3) * 45}ms`;
        io.observe(el);
      });
    }

    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".filter-chip[data-filter]")
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".plant-item")
    );
    const countEl = document.getElementById("filter-count");
    const clearEl = document.getElementById("filter-clear");
    const dropdowns = Array.from(
      document.querySelectorAll<HTMLDetailsElement>(".filter-dd")
    );
    const noMatches = document.getElementById("no-matches");
    const noMatchesClear = document.getElementById("no-matches-clear");
    const searchInput = document.getElementById(
      "plant-search"
    ) as HTMLInputElement | null;
    const tagBar = document.getElementById("active-tag-bar");
    const tagLabel = document.getElementById("active-tag-label");
    const tagClear = document.getElementById("active-tag-clear");
    const sortDropdown = document.querySelector<HTMLDetailsElement>("#plant-sort");
    const sortLabel = document.getElementById("plant-sort-label");
    const sortChoices = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-sort]")
    );
    const total = items.length;

    const restored = restoreState;
    restoreState = undefined;
    const selectedTypes = new Set(restored?.types ?? []);
    const selectedTraits = new Set(restored?.traits ?? []);
    const selectedSuns = new Set(restored?.suns ?? []);
    const filterSets: Record<string, Set<string>> = {
      type: selectedTypes,
      trait: selectedTraits,
      sun: selectedSuns,
    };
    if (searchInput) searchInput.value = restored?.search ?? "";
    let sortMode = restored?.sort ?? "name";
    let searchTerm = (restored?.search ?? "").trim().toLowerCase();
    // A tag handed in via `?tag=` (from a clickable tag on a plant page). It
    // filters by the same data-tags mechanism as the trait chips, but can be
    // any tag — not only the curated shortlist.
    let activeTag =
      restored?.tag ??
      new URLSearchParams(window.location.search).get("tag")?.trim() ?? "";

    for (const chip of chips) {
      chip.setAttribute(
        "aria-pressed",
        String(filterSets[chip.dataset.filter ?? ""]?.has(chip.dataset.value ?? "") ?? false)
      );
    }

    function sortItems() {
      for (const choice of sortChoices) {
        const selected = choice.dataset.sort === sortMode;
        choice.setAttribute("aria-pressed", String(selected));
        if (selected && sortLabel) sortLabel.textContent = choice.textContent?.trim() ?? "";
      }
      // The source array stays alphabetical; stable sorting keeps that order
      // for equal dates and places entries without dates at the end.
      const sorted = sortMode === "recent"
        ? [...items].sort((a, b) => Number(b.dataset.added) - Number(a.dataset.added))
        : items;
      grid.append(...sorted);
    }

    // Update the per-dropdown count badge from its own pressed chips.
    function updateBadges() {
      for (const dd of dropdowns) {
        const badge = dd.querySelector<HTMLElement>(".filter-badge");
        if (!badge) continue;
        const count = dd.querySelectorAll('.filter-chip[aria-pressed="true"]')
          .length;
        badge.textContent = String(count);
        badge.classList.toggle("hidden", count === 0);
      }
    }

    function apply() {
      let visible = 0;
      for (const item of items) {
        const type = item.dataset.type ?? "";
        const sun = item.dataset.sun ?? "";
        const tags = item.dataset.tags ?? "";
        const name = (item.dataset.name ?? "").toLowerCase();
        const latin = (item.dataset.latin ?? "").toLowerCase();
        // Types and sun levels are OR'd (broaden), traits are AND'd (narrow).
        const typeOk = selectedTypes.size === 0 || selectedTypes.has(type);
        const sunOk =
          selectedSuns.size === 0 ||
          [...selectedSuns].some((s) => sun.includes(`|${s}|`));
        const traitOk = [...selectedTraits].every((t) =>
          tags.includes(`|${t}|`)
        );
        const tagOk = activeTag === "" || tags.includes(`|${activeTag}|`);
        const searchOk =
          searchTerm === "" ||
          name.includes(searchTerm) ||
          latin.includes(searchTerm) ||
          tags.toLowerCase().includes(searchTerm);
        const show = typeOk && sunOk && traitOk && tagOk && searchOk;
        item.hidden = !show;
        if (show) visible++;
      }

      const active =
        selectedTypes.size +
        selectedTraits.size +
        selectedSuns.size +
        (searchTerm ? 1 : 0) +
        (activeTag ? 1 : 0);
      if (countEl) {
        countEl.textContent =
          active === 0
            ? `Showing all ${total} plants`
            : `Showing ${visible} of ${total} plants`;
      }
      if (clearEl) clearEl.classList.toggle("hidden", active === 0);
      updateBadges();
      if (noMatches) noMatches.classList.toggle("hidden", visible !== 0);
      catalogState = {
        search: searchInput?.value ?? "",
        types: [...selectedTypes],
        traits: [...selectedTraits],
        suns: [...selectedSuns],
        tag: activeTag,
        sort: sortMode,
      };
    }

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const value = chip.dataset.value ?? "";
        const set = filterSets[chip.dataset.filter ?? ""];
        if (!set) return;
        const pressed = chip.getAttribute("aria-pressed") === "true";
        if (pressed) {
          set.delete(value);
          chip.setAttribute("aria-pressed", "false");
        } else {
          set.add(value);
          chip.setAttribute("aria-pressed", "true");
        }
        apply();
      });
    }

    // Reflect the `?tag=` filter in the UI: show a removable pill and drop the
    // query param when it's cleared, so a refresh doesn't reapply it.
    function syncTagBar() {
      if (!tagBar) return;
      tagBar.classList.toggle("hidden", activeTag === "");
      tagBar.classList.toggle("flex", activeTag !== "");
      if (tagLabel) tagLabel.textContent = activeTag;
    }

    function clearTag() {
      if (activeTag === "") return;
      activeTag = "";
      const url = new URL(window.location.href);
      url.searchParams.delete("tag");
      window.history.replaceState(window.history.state, "", url);
      syncTagBar();
      apply();
    }

    tagClear?.addEventListener("click", clearTag);

    function clearAll() {
      selectedTypes.clear();
      selectedTraits.clear();
      selectedSuns.clear();
      for (const chip of chips) chip.setAttribute("aria-pressed", "false");
      searchTerm = "";
      if (searchInput) searchInput.value = "";
      clearTag();
      apply();
    }

    searchInput?.addEventListener("input", () => {
      searchTerm = searchInput.value.trim().toLowerCase();
      apply();
    });

    for (const choice of sortChoices) {
      choice.addEventListener("click", () => {
        sortMode = choice.dataset.sort ?? "name";
        sortItems();
        apply();
        if (sortDropdown) {
          sortDropdown.open = false;
          sortDropdown.querySelector("summary")?.focus();
        }
      });
    }

    clearEl?.addEventListener("click", clearAll);
    noMatchesClear?.addEventListener("click", clearAll);

    // Paint the initial state, including any `?tag=` handed in from a plant page.
    syncTagBar();
    sortItems();
    apply();

    // Close any open dropdown when clicking outside one, or pressing Escape.
    document.addEventListener("click", (e) => {
      for (const dd of dropdowns) {
        if (dd.open && !dd.contains(e.target as Node)) dd.open = false;
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        for (const dd of dropdowns) {
          if (!dd.open) continue;
          if (dd.contains(document.activeElement)) dd.querySelector("summary")?.focus();
          dd.open = false;
        }
      }
    });
  }

  initCatalog();
  // Restore before the transition paints the incoming grid.
  document.addEventListener("astro:after-swap", initCatalog);
  document.addEventListener("astro:page-load", initCatalog);
</script>
