---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import MonthTimeline from "../components/MonthTimeline.astro";

// Only plants with a real floral display appear on the timeline.
const rows = (await getCollection("plants"))
  .filter((p) => p.data.bloomMonths.length > 0)
  .map((p) => ({
    name: p.data.name,
    url: `/plants/${p.id}/`,
    months: p.data.bloomMonths,
  }));
---

<Layout
  title="Bloom Timeline"
  description="See when each plant in the ShyMoose garden flowers across the year, and what's blooming right now."
>
  <section class="mb-6">
    <a
      href="/"
      class="mb-5 inline-flex items-center gap-1.5 text-sm font-medium text-leaf-600 transition hover:text-leaf-800 dark:text-leaf-400 dark:hover:text-leaf-200"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" />
      </svg>
      All plants
    </a>
    <h1 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      Bloom Timeline
    </h1>
    <p class="mt-2 max-w-prose text-leaf-700 dark:text-leaf-300">
      When each plant flowers across the season. The highlighted column is the
      current month, so you can see what's in bloom right now.
    </p>
  </section>

  <MonthTimeline
    rows={rows}
    nowVerb="Blooming"
    emptyMessage="Nothing is flowering this month — check back as the season turns."
  >
    <svg slot="now-icon" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </svg>
  </MonthTimeline>

  <p class="mt-6 text-xs text-leaf-500 dark:text-leaf-400">
    Bloom times are typical for our region and shift a little year to year with
    the weather. Conifers and vegetables are left off the timeline.
  </p>
</Layout>
