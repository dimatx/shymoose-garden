---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const MONTHS = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
];

// Only plants with a real floral display appear on the timeline.
const plants = (await getCollection("plants"))
  .filter((p) => p.data.bloomMonths.length > 0)
  .sort((a, b) => {
    const firstA = Math.min(...a.data.bloomMonths);
    const firstB = Math.min(...b.data.bloomMonths);
    if (firstA !== firstB) return firstA - firstB;
    const lastA = Math.max(...a.data.bloomMonths);
    const lastB = Math.max(...b.data.bloomMonths);
    if (lastA !== lastB) return lastA - lastB;
    return a.data.name.localeCompare(b.data.name);
  });

// Build-time current month, used as a fallback before the client script runs.
const buildMonth = new Date().getMonth() + 1; // 1–12
---

<Layout
  title="Bloom Timeline"
  description="See when each plant in the ShyMoose garden flowers across the year, and what's blooming right now."
>
  <section class="mb-6">
    <a
      href="/"
      class="mb-5 inline-flex items-center gap-1.5 text-sm font-medium text-leaf-600 transition hover:text-leaf-800 dark:text-leaf-400 dark:hover:text-leaf-200"
    >
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6" />
      </svg>
      All plants
    </a>
    <h1 class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      Bloom Timeline
    </h1>
    <p class="mt-2 max-w-prose text-leaf-700 dark:text-leaf-300">
      When each plant flowers across the season. The highlighted column is the
      current month, so you can see what's in bloom right now.
    </p>
  </section>

  <!-- Blooming now -->
  <section
    id="blooming-now"
    class="mb-8 rounded-2xl border border-leaf-200/80 bg-white p-5 dark:border-leaf-800/80 dark:bg-leaf-900"
  >
    <h2 class="flex items-center gap-2 font-serif text-lg font-semibold">
      <span
        class="grid h-7 w-7 place-items-center rounded-full bg-leaf-100 text-leaf-600 dark:bg-leaf-800 dark:text-leaf-300"
        aria-hidden="true"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
        </svg>
      </span>
      Blooming <span id="now-month" class="text-leaf-600 dark:text-leaf-400">now</span>
    </h2>
    <ul
      id="now-list"
      class="mt-3 flex flex-wrap gap-2"
      data-build-month={buildMonth}
    >
      {
        plants
          .filter((p) => p.data.bloomMonths.includes(buildMonth))
          .map((p) => (
            <li>
              <a
                href={`/plants/${p.id}/`}
                class="inline-flex items-center gap-1.5 rounded-full bg-leaf-100 px-3 py-1.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-200 dark:bg-leaf-800 dark:text-leaf-100 dark:hover:bg-leaf-700"
              >
                <span class="h-2 w-2 rounded-full bg-leaf-500" aria-hidden="true" />
                {p.data.name}
              </a>
            </li>
          ))
      }
    </ul>
    <p
      id="now-empty"
      class="mt-3 hidden text-sm text-leaf-600 dark:text-leaf-400"
    >
      Nothing is flowering this month — check back as the season turns.
    </p>
  </section>

  <!-- Timeline chart -->
  <section class="overflow-x-auto pb-2">
    <div class="min-w-[640px]">
      <!-- Month header -->
      <div class="grid grid-cols-[8.5rem_repeat(12,1fr)] gap-px">
        <div></div>
        {
          MONTHS.map((m, i) => (
            <div
              data-month={i + 1}
              class="month-head rounded-t-md px-1 py-1.5 text-center text-xs font-semibold uppercase tracking-wide text-leaf-500 dark:text-leaf-400"
            >
              {m}
            </div>
          ))
        }
      </div>

      <!-- Rows -->
      <div class="divide-y divide-leaf-200/70 dark:divide-leaf-800/70">
        {
          plants.map((plant) => {
            const months = plant.data.bloomMonths;
            return (
              <div
                class="bloom-row grid grid-cols-[8.5rem_repeat(12,1fr)] items-center gap-px py-1.5"
                data-bloom-row={months.join(",")}
                data-name={plant.data.name}
                data-url={`/plants/${plant.id}/`}
              >
                <a
                  href={`/plants/${plant.id}/`}
                  class="truncate pr-2 text-sm font-medium text-leaf-800 transition hover:text-leaf-950 dark:text-leaf-200 dark:hover:text-leaf-50"
                  title={plant.data.name}
                >
                  {plant.data.name}
                </a>
                {MONTHS.map((_, i) => {
                  const month = i + 1;
                  const active = months.includes(month);
                  const isStart = active && !months.includes(month - 1);
                  const isEnd = active && !months.includes(month + 1);
                  const rounding = [
                    isStart ? "rounded-l-full" : "",
                    isEnd ? "rounded-r-full" : "",
                  ].join(" ");
                  return (
                    <div data-month={month} class="month-cell px-px py-0.5">
                      <div
                        class={`h-5 ${active ? `bg-leaf-400 dark:bg-leaf-500 ${rounding}` : ""}`}
                      />
                    </div>
                  );
                })}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <p class="mt-6 text-xs text-leaf-500 dark:text-leaf-400">
    Bloom times are typical for our region and shift a little year to year with
    the weather. Conifers and vegetables are left off the timeline.
  </p>
</Layout>

<style>
  /* The current-month column is highlighted by the script below. */
  .month-head.is-current {
    color: var(--color-leaf-700);
    background-color: color-mix(in oklab, var(--color-leaf-200) 70%, transparent);
  }
  :global(.dark) .month-head.is-current {
    color: var(--color-leaf-100);
    background-color: color-mix(in oklab, var(--color-leaf-700) 50%, transparent);
  }
  .month-cell.is-current {
    background-color: color-mix(in oklab, var(--color-leaf-200) 55%, transparent);
  }
  :global(.dark) .month-cell.is-current {
    background-color: color-mix(in oklab, var(--color-leaf-800) 60%, transparent);
  }
</style>

<script>
  const MONTH_NAMES = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
  ];

  const now = new Date().getMonth() + 1; // 1–12

  // Label: "Blooming in June"
  const label = document.getElementById("now-month");
  if (label) label.textContent = `in ${MONTH_NAMES[now - 1]}`;

  // Highlight the current-month column (header + every cell).
  document
    .querySelectorAll(`[data-month="${now}"]`)
    .forEach((el) => el.classList.add("is-current"));

  // Recompute "Blooming now" for the visitor's actual current month.
  const list = document.getElementById("now-list");
  const empty = document.getElementById("now-empty");
  const buildMonth = list ? Number(list.dataset.buildMonth) : now;

  if (list && now !== buildMonth) {
    const blooming = [];
    document.querySelectorAll(".bloom-row").forEach((row) => {
      const el = /** @type {HTMLElement} */ (row);
      const months = (el.dataset.bloomRow || "")
        .split(",")
        .map(Number)
        .filter(Boolean);
      if (months.includes(now)) {
        blooming.push({ name: el.dataset.name || "", url: el.dataset.url || "#" });
      }
    });

    list.innerHTML = blooming
      .map(
        (p) =>
          `<li><a href="${p.url}" class="inline-flex items-center gap-1.5 rounded-full bg-leaf-100 px-3 py-1.5 text-sm font-medium text-leaf-800 transition hover:bg-leaf-200 dark:bg-leaf-800 dark:text-leaf-100 dark:hover:bg-leaf-700"><span class="h-2 w-2 rounded-full bg-leaf-500" aria-hidden="true"></span>${p.name}</a></li>`
      )
      .join("");

    if (empty) empty.classList.toggle("hidden", blooming.length > 0);
  } else if (list && empty) {
    empty.classList.toggle("hidden", list.children.length > 0);
  }
</script>
