---
import Layout from "../layouts/Layout.astro";
import MonthTimeline from "../components/MonthTimeline.astro";
import Icon from "../components/Icon.astro";
import { getTimelineRows } from "../lib/plants";

// Only plants with a defined pruning window appear on the calendar.
// Annual vegetables (pulled at season's end) carry no pruneMonths.
const rows = await getTimelineRows("pruneMonths");
---

<Layout
  title="Pruning Calendar"
  description="See the month to prune or cut back each plant in the ShyMoose garden, and what needs pruning right now."
>
  <section class="mb-6">
    <a
      href="/"
      class="mb-5 inline-flex items-center gap-1.5 text-sm font-medium text-leaf-600 transition hover:text-leaf-800 dark:text-leaf-400 dark:hover:text-leaf-200"
    >
      <Icon name="chevron-left" class="h-4 w-4" strokeWidth={2} />
      All plants
    </a>
    <h1 class="text-balance font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      Pruning Calendar
    </h1>
    <p class="mt-2 max-w-prose text-pretty text-leaf-700 dark:text-leaf-300">
      When to prune or cut back each plant across the year. The highlighted
      column is the current month, so you can see what to tackle right now.
    </p>
  </section>

  <MonthTimeline
    rows={rows}
    nowVerb="Prune"
    emptyMessage="Nothing needs pruning this month — enjoy the garden as it is."
  >
    <Icon slot="now-icon" name="scissors" class="h-4 w-4" />
  </MonthTimeline>

  <p class="mt-6 text-xs text-leaf-500 dark:text-leaf-400">
    Pruning times follow each plant's care notes and shift a little year to year
    with the weather. Annual vegetables, which are simply pulled at season's
    end, are left off the calendar.
  </p>
</Layout>
